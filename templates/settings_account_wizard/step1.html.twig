{% extends 'base.html.twig' %}
{% form_theme form 'form/app_theme.html.twig' %}

{% block pageheader %}
    <div class="flex items-center justify-between px-8 pt-7 pb-5 shrink-0" style="border-bottom:1px solid var(--border)">
        <div>
            <div class="text-[20px] font-semibold tracking-tight">Settings</div>
            <div class="text-[12px] mt-0.5 text-muted">Configure bank access and synchronization</div>
        </div>
    </div>
{% endblock %}

{% block body %}
    <!-- Horizontal tab bar -->
    <div class="flex items-end gap-1 px-8 shrink-0" style="border-bottom:1px solid var(--border)">
        <a href="{{ path('app_settings_index') }}" class="tab-btn">App-Settings</a>
        <a href="{{ path('app_settings_accounts_index') }}" class="tab-btn active">Accounts</a>
    </div>

    <div class="flex-1 overflow-y-auto px-8 py-8">
        <div class="max-w-2xl">

            <!-- Card -->
            <div class="rounded-xl p-7 transition-colors" style="background:var(--surface);border:1px solid var(--border)">

                <div class="pb-5 flex flex-col md:flex-row md:items-center justify-between gap-4" style="border-bottom:1px solid var(--border)">
                    <div>
                        <h3 class="text-[17px] font-bold" style="color:var(--tx)">Set up bank connection</h3>
                        <p class="text-[12px] text-muted leading-relaxed mt-1">
                            Enter your interface details here to enable automatic retrieval of account transactions.
                        </p>
                    </div>
                    <span class="bg-accent/10 text-accent font-bold px-3 py-1 rounded-full text-[11px] font-mono shrink-0 self-start md:self-auto">
                        Step 1 of 3
                    </span>
                </div>

                <!-- Progress bar -->
                <div class="w-full h-1.5 rounded-full overflow-hidden mt-5 mb-7" style="background:var(--progress)">
                    <div class="bg-accent h-full rounded-full transition-all duration-300 ease-out" style="width:33%"></div>
                </div>

                {{ form_start(form) }}
                <div class="flex flex-col gap-5">

                    <!-- Row: Bankname + FinTS URL -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div>{{ form_row(form.name) }}</div>
                        <div>{{ form_row(form.url) }}</div>
                    </div>

                    <!-- Row: BLZ + BIC -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div>{{ form_row(form.bankCode) }}</div>
                        <div>{{ form_row(form.bic) }}</div>
                    </div>

                    <!-- Divider -->
                    <div class="flex items-center gap-3 my-1">
                        <div class="flex-1 h-px" style="background:var(--border)"></div>
                        <span class="font-mono text-[10px] uppercase tracking-[1px] text-muted">Credentials</span>
                        <div class="flex-1 h-px" style="background:var(--border)"></div>
                    </div>

                    <!-- Encryption notice banner -->
                    <div class="flex items-start gap-3 px-4 py-3 rounded-lg" style="background:rgba(91,138,245,.08);border:1px solid rgba(91,138,245,.2)">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512" class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="currentColor"><!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.--><path d="M128 96l0 64 128 0 0-64c0-35.3-28.7-64-64-64s-64 28.7-64 64zM64 160l0-64C64 25.3 121.3-32 192-32S320 25.3 320 96l0 64c35.3 0 64 28.7 64 64l0 224c0 35.3-28.7 64-64 64L64 512c-35.3 0-64-28.7-64-64L0 224c0-35.3 28.7-64 64-64z"/></svg>
                        <div>
                            <div class="text-[12px] font-medium text-accent mb-0.5">End-to-end encrypted</div>
                            <div class="text-[11px] text-muted leading-relaxed">
                                Username and password are stored exclusively encrypted in the local database.
                                The plain text never leaves this device.
                            </div>
                        </div>
                    </div>

                    <!-- Row: Username + Password -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div>{{ form_row(form.username) }}</div>
                        <div>{{ form_row(form.password) }}</div>
                    </div>
                </div><!-- /fields -->

                <!-- Footer actions -->
                <div class="flex items-center justify-end mt-8 pt-6" style="border-top:1px solid var(--border)">
                    <button type="submit"
                        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-accent text-white text-[13px] font-medium cursor-pointer border-none transition-all hover:-translate-y-px hover:bg-[#7aa0f7] hover:shadow-[0_4px_14px_rgba(91,138,245,.3)]"
                    >
                        Save &amp; continue →
                    </button>
                </div>

                {{ form_end(form) }}
            </div><!-- /card -->

        </div>
    </div>
{% endblock %}
