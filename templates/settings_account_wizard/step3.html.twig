{% extends 'base.html.twig' %}

{% block pageheader %}
    <div class="flex items-center justify-between px-8 pt-7 pb-5 shrink-0" style="border-bottom:1px solid var(--border)">
        <div>
            <div class="text-[20px] font-semibold tracking-tight">Settings</div>
            <div class="text-[12px] mt-0.5 text-muted">Configure bank access and synchronization</div>
        </div>
    </div>
{% endblock %}

{% block body %}
    <!-- Horizontal tab bar -->
    <div class="flex items-end gap-1 px-8 shrink-0" style="border-bottom:1px solid var(--border)">
        <a href="{{ path('app_settings_index') }}" class="tab-btn">App-Settings</a>
        <a href="{{ path('app_settings_accounts_index') }}" class="tab-btn active">Accounts</a>
    </div>

    <div class="flex-1 overflow-y-auto px-8 py-8">
        <div class="max-w-2xl">

            <!-- Card -->
            <div class="rounded-xl p-7 transition-colors" style="background:var(--surface);border:1px solid var(--border)">

                <div class="pb-5 flex flex-col md:flex-row md:items-center justify-between gap-4" style="border-bottom:1px solid var(--border)">
                    <div>
                        <h3 class="text-[17px] font-bold" style="color:var(--tx)">Set up bank connection</h3>
                        <p class="text-[12px] text-muted leading-relaxed mt-1">
                            The following subaccounts have been fetched.
                        </p>
                    </div>
                    <span class="bg-accent/10 text-accent font-bold px-3 py-1 rounded-full text-[11px] font-mono shrink-0 self-start md:self-auto">
                        Step 3 of 3
                    </span>
                </div>

                <!-- Progress bar -->
                <div class="w-full h-1.5 rounded-full overflow-hidden mt-5 mb-7" style="background:var(--progress)">
                    <div class="bg-accent h-full rounded-full transition-all duration-300 ease-out" style="width:100%"></div>
                </div>

                {% if tanRequired %}
                    {% include 'account/_tanChallenge.html.twig' %}
                {% else %}

                    <div class="rounded-xl overflow-hidden" style="border:1px solid var(--border)">
                        <table class="w-full border-collapse">
                            <thead>
                            <tr style="background:var(--surface)">
                                <th scope="col" class="text-left font-mono text-[10px] tracking-[1px] uppercase text-muted px-5 py-3 font-medium" style="border-bottom:2px solid var(--border)">IBAN</th>
                                <th scope="col" class="text-left font-mono text-[10px] tracking-[1px] uppercase text-muted px-5 py-3 font-medium" style="border-bottom:2px solid var(--border)">Account Number</th>
                                <th scope="col" class="text-left font-mono text-[10px] tracking-[1px] uppercase text-muted px-5 py-3 font-medium" style="border-bottom:2px solid var(--border)">Description</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for subAccount in subAccounts %}
                                <tr style="background:var(--surface);border-top:1px solid var(--border)">
                                    <td class="px-5 py-3 text-[13px] font-mono whitespace-nowrap">{{ subAccount.iban }}</td>
                                    <td class="px-5 py-3 text-[13px] text-muted whitespace-nowrap">{{ subAccount.accountNumber }}</td>
                                    <td class="px-5 py-3 text-[13px] text-muted whitespace-nowrap">{{ subAccount.description }}</td>
                                </tr>
                            {% else %}
                                <tr style="background:var(--surface);border-top:1px solid var(--border)">
                                    <td colspan="4" class="px-5 py-6 text-center text-[12px] text-muted uppercase font-medium">No records found</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <!-- Footer actions -->
                    <div class="flex items-center justify-end mt-8 pt-6" style="border-top:1px solid var(--border)">
                        <a href="{{ path('app_settings_accounts_index') }}"
                            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-accent text-white text-[13px] font-medium cursor-pointer border-none transition-all hover:-translate-y-px hover:bg-[#7aa0f7] hover:shadow-[0_4px_14px_rgba(91,138,245,.3)]"
                        >
                            Finish
                        </a>
                    </div>

                {% endif %}
            </div><!-- /card -->

        </div>
    </div>
{% endblock %}
