{% extends 'base.html.twig' %}

{% block body %}
    <twig:Header title="Add Account"></twig:Header>

    <div class="grid grid-cols-8 gap-4 px-4 pt-6 dark:bg-gray-900">
        <twig:Card grid="col-span-8 xl:col-start-2 xl:col-end-8">
            <div class="border-b border-cream-border dark:border-dark-border pb-4 flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <h3 class="text-xl font-bold text-primary-dark dark:text-primary-light">Bankverbindung einrichten</h3>
                    <p class="text-xs text-text-muted leading-relaxed mt-1">Geben Sie hier Ihre Schnittstellendaten ein, um den elektronischen Abruf von Kontobewegungen zu aktivieren.</p>
                </div>
                <span class="bg-accent/10 text-accent font-bold px-3 py-1 rounded-full text-xs font-mono shrink-0">Schritt 2 von 3</span>
            </div>

            <!-- Step Progress Indicator -->
            <div class="w-full bg-cream-surface dark:bg-dark-border h-2 rounded-full overflow-hidden">
                <div class="bg-primary h-full transition-all duration-300 ease-out" style="width: 66%;"></div>
            </div>

            <h4 class="text-xs font-bold uppercase tracking-wider text-accent border-b border-cream-border/50 dark:border-dark-border pb-1">Schritt 3: Unterkonto-Zuordnung</h4>

            {% if tanRequired %}
                {% include 'account/_tanChallenge.html.twig' %}
            {% else %}

                <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-600">
                    <thead>
                    <tr>
                        <th scope="col" class="p-2 text-xs font-medium text-left text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700">IBAN</th>
                        <th scope="col" class="p-2 text-xs font-medium text-left text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700">Account Number</th>
                        <th scope="col" class="p-2 text-xs font-medium text-center text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700">Enabled</th>
                        <th scope="col" class="p-2 text-xs font-medium text-left text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700">Description</th>
                    </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200 dark:bg-gray-800 dark:divide-gray-700">
                    {% for subAccount in subAccounts %}
                        <tr class="odd:bg-white odd:dark:bg-gray-900 even:bg-gray-50 even:dark:bg-gray-800 border-b dark:border-gray-700 hover:bg-yellow-100 dark:hover:bg-gray-600">
                            <td class="p-1 px-2 text-xs font-normal text-gray-600 whitespace-nowrap dark:text-gray-400">{{ subAccount.iban }}</td>
                            <td class="p-1 px-2 text-xs font-normal text-gray-600 whitespace-nowrap dark:text-gray-400">{{ subAccount.accountNumber }}</td>
                            <td class="p-1 px-2 text-xs font-normal text-gray-600 flex justify-center whitespace-nowrap dark:text-gray-400">
                                {% if subAccount.enabled %}
                                    <i class="text-emerald-700 fa-solid fa-circle-check"></i>
                                {% else %}
                                    <i class="text-red-700 fa-solid fa-circle-xmark"></i>
                                {% endif %}
                            </td>
                            <td class="p-1 px-2 text-xs font-normal text-gray-600 whitespace-nowrap dark:text-gray-400">{{ subAccount.description }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="p-4 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-400">No records found</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>

            {% endif %}
        </twig:Card>
    </div>
{% endblock %}
