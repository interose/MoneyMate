{% extends 'base.html.twig' %}

{% block body %}
    <twig:Header title="Add Account"></twig:Header>

    <div class="grid grid-cols-8 gap-4 px-4 pt-6 dark:bg-gray-900">
        <twig:Card grid="col-span-8 xl:col-start-2 xl:col-end-8">
            <div class="border-b border-cream-border dark:border-dark-border pb-4 flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <h3 class="text-xl font-bold text-primary-dark dark:text-primary-light">Bankverbindung einrichten</h3>
                    <p class="text-xs text-text-muted leading-relaxed mt-1">Geben Sie hier Ihre Schnittstellendaten ein, um den elektronischen Abruf von Kontobewegungen zu aktivieren.</p>
                </div>
                <span class="bg-accent/10 text-accent font-bold px-3 py-1 rounded-full text-xs font-mono shrink-0">Schritt 2 von 3</span>
            </div>

            <!-- Step Progress Indicator -->
            <div class="w-full bg-cream-surface dark:bg-dark-border h-2 rounded-full overflow-hidden">
                <div class="bg-primary h-full transition-all duration-300 ease-out" style="width: 66%;"></div>
            </div>

            <div
                data-controller="account-tan-setup"
                data-account-tan-setup-url-value="{{ path('app_account_fetch_tanmedia', {'id': account.id}) }}"
            >

                {{ form_start(form, {'attr': {'data-account-tan-setup-target': 'form'}}) }}

                <h4 class="text-xs font-bold uppercase tracking-wider text-accent border-b border-cream-border/50 dark:border-dark-border pb-1">Schritt 2: Sicherheits- und TAN-Verfahren</h4>

                <div class="grid grid-cols-2 gap-4">
                    <div>{{ form_row(form.tanMechanism, {'attr': {'data-account-tan-setup-target': 'tanModeSelect', 'data-action': 'account-tan-setup#fetchTanMedia'}}) }}</div>
                    <div>{{ form_row(form.tanMediaName, {'attr': {'data-account-tan-setup-target': 'tanMediaSelect'}}) }}</div>
                </div>

                <div class="flex justify-between">
                    <a
                        class="text-gray-900 bg-gray-100 hover:bg-gray-200 focus:outline-none font-medium rounded-lg text-sm px-5 py-2 text-center mt-4 inline-flex items-center"
                        href="{{ path('app_settings_account_step1', {'id': account.id}) }}"
                    >
                        back
                    </a>
                    <button class="text-white bg-green-700 hover:bg-green-800 focus:outline-none font-medium rounded-lg text-sm px-5 py-2 text-center mt-4 inline-flex items-center">
                        <i class="fa-solid fa-floppy-disk me-2.5"></i>Next
                    </button>
                </div>

                {{ form_end(form) }}

            </div>

        </twig:Card>
    </div>
{% endblock %}
