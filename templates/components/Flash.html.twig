{%  props type = 'success' %}

{% if type starts with 'success' %}
    {% set class = 'text-green bg-green/10' %}
    {% set timerbar = 'bg-green' %}
    {% set icon = '<svg fill="none" height="14" viewBox="0 0 14 14" width="14"><circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.3"></circle><path d="M4.5 7l2 2 3-3.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4"></path></svg>' %}
{% elseif type starts with 'error' %}
    {% set class = 'text-pink  bg-pink/10' %}
    {% set timerbar = 'bg-pink' %}
    {% set icon = '<svg fill="none" height="14" viewBox="0 0 14 14" width="14"><circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.3"></circle><path d="M5 5l4 4M9 5l-4 4" stroke="currentColor" stroke-linecap="round" stroke-width="1.4"></path></svg>' %}
{% elseif type starts with 'warning' %}
    {% set class = 'text-orange-400 bg-orange-400/10' %}
    {% set timerbar = 'bg-orange-400' %}
    {% set icon = '<svg fill="none" height="14" viewBox="0 0 14 14" width="14"><path d="M7 1.5L13 12.5H1L7 1.5Z" stroke="currentColor" stroke-linejoin="round" stroke-width="1.3"></path><path d="M7 5.5v3M7 10v.5" stroke="currentColor" stroke-linecap="round" stroke-width="1.4"></path></svg>' %}
{% elseif type starts with 'notice' %}
    {% set class = 'text-accent bg-accent/10' %}
    {% set timerbar = 'bg-accent' %}
    {% set icon = '<svg fill="none" height="14" viewBox="0 0 14 14" width="14"><circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.3"></circle><path d="M7 6.5v4M7 4v.5" stroke="currentColor" stroke-linecap="round" stroke-width="1.4"></path></svg>' %}
{% endif %}

<div
    class="fixed top-5 right-5 z-[400] flex flex-col gap-2 items-end pointer-events-none [&>*]:pointer-events-auto"
    role="alert"
    data-turbo-temporary
    data-controller="closeable"
    {% if not (type ends with 'static') %}
    data-closeable-auto-close-value="5000"
    {% endif %}
>
    <div class="relative flex items-center gap-3 w-full max-w-[320px] bg-card border border-white/[.12] rounded-xl px-4 py-3 shadow-[0_12px_36px_rgba(0,0,0,.55)] transition-all duration-300 ease-out overflow-hidden" id="toast-4" role="alert">
        <div class="flex-shrink-0 flex items-center justify-center w-7 h-7 rounded-lg {{ class }}">
            {{ icon|raw }}
        </div>
        <p class="flex-1 text-[13px] text-white/80 font-normal leading-snug">{% block content %}{% endblock %}</p>
        <button
            class="flex-shrink-0 flex items-center justify-center w-6 h-6 rounded-md text-white/25 hover:text-white hover:bg-white/[.08] transition-colors cursor-pointer border-0 bg-transparent"
            data-action="closeable#close"
        >
            <svg fill="none" height="10" viewBox="0 0 10 10" width="10">
                <path d="M1.5 1.5l7 7M8.5 1.5l-7 7" stroke="currentColor" stroke-linecap="round" stroke-width="1.4"></path>
            </svg>
        </button>
        <!-- Timer bar -->
        <div class="absolute bottom-0 left-0 h-[2px] w-full {{ timerbar }} opacity-40 transition-all duration-[5000ms] ease-linear" data-closeable-target="timerbar"></div>
    </div>
</div>
