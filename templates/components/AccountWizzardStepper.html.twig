<ol class="items-center w-full space-y-4 sm:flex sm:space-x-8 sm:space-y-0 rtl:space-x-reverse mb-10">
    {% for step in steps %}
        <li class="flex items-center space-x-2.5 rtl:space-x-reverse {% if this.currentStep == loop.index %}font-bold text-[#112D4E] dark:text-blue-500{% else %}text-gray-500 dark:text-gray-400{% endif %}">
            <span class="flex items-center justify-center w-8 h-8 border rounded-full shrink-0 {% if this.currentStep == loop.index %}border-[#112D4E] border-2 dark:border-blue-500{% else %}border-gray-500 dark:border-gray-400{% endif %}">{{ loop.index }}</span>
            <span>
                <h3 class="font-medium leading-tight">
                    {% if this.account.isFinal %}
                        <a href="{{ path(step.routeName, {'id': this.account.id}) }}">{{ step.title }}</a>
                    {% else %}
                        {{ step.title }}
                    {% endif %}
                </h3>
                <p class="text-sm">{{ step.description }}</p>
            </span>
        </li>
    {% endfor %}
</ol>