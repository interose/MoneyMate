{% extends 'base.html.twig' %}

{% block body %}
    <twig:Header title=""></twig:Header>

    <div class="grid grid-cols-6 gap-4 px-4 pt-6 dark:bg-gray-900">
        <twig:Card title="Add Category Assignment Rule" grid="col-start-2 col-end-5">
            <turbo-frame id="mdl">

                {% if app.request.headers.get('turbo-frame') is not empty %}
                    <twig:ModalHeader><i class="fa-solid fa-tag me-2.5"></i>Add Category Assignment Rule</twig:ModalHeader>
                {% endif %}

                {{ include('settings_rule/_form.html.twig') }}
            </turbo-frame>
        </twig:Card>
    </div>
{% endblock %}
