<!-- Comment filter chips -->
<div
    class="flex gap-[5px]"
    data-controller="stock-filter-chips"
    data-stock-filter-chips-active-class="is-selected border-blue-500 text-blue-400"
    data-stock-filter-chips-inactive-class="border-white/[.07] text-white/40 hover:border-white/[.15] hover:text-white"
>
    <a
        href="/stock/?filter%5Bcomment%5D%5B0%5D=Kaufen"
        data-turbo-frame="stock-list"
        data-action="click->stock-filter-chips#toggle"
        data-stock-filter-chips-target="chip"
        class="comment-chip px-[9px] py-[3px] rounded-full text-[11.5px] font-medium border transition-all whitespace-nowrap bg-elevated cursor-pointer border-white/[.07] text-white/40 hover:border-white/[.15] hover:text-white"
    >
        Kaufen
    </a>
    <a
        href="/stock/?filter%5Bcomment%5D%5B0%5D=Nachkauf"
        data-turbo-frame="stock-list"
        data-action="click->stock-filter-chips#toggle"
        data-stock-filter-chips-target="chip"
        class="comment-chip px-[9px] py-[3px] rounded-full text-[11.5px] font-medium border transition-all whitespace-nowrap bg-elevated cursor-pointer border-white/[.07] text-white/40 hover:border-white/[.15] hover:text-white"
    >
        Nachkauf
    </a>
</div>
