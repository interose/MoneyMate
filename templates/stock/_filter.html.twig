<div class="p-2">
    <button
            id="filterDropdownButton"
            data-dropdown-toggle="filterDropdown"
            data-dropdown-placement="bottom"
            data-dropdown-offset-distance="0"
            data-dropdown-offset-skidding="0"
            class="p-1 px-2 me-4 text-xs flex items-center justify-center font-medium text-center text-gray-600 rounded bg-gray-100 hover:bg-gray-200 border border-gray-300"
            type="button">
        <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="h-4 w-4 mr-2 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M3 3a1 1 0 011-1h12a1 1 0 011 1v3a1 1 0 01-.293.707L12 11.414V15a1 1 0 01-.293.707l-2 2A1 1 0 018 17v-5.586L3.293 6.707A1 1 0 013 6V3z" clip-rule="evenodd"></path>
        </svg>
        Filter
        <svg class="-mr-1 ml-1.5 w-4 h-4" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path clip-rule="evenodd" fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"></path>
        </svg>
    </button>

    <div id="filterDropdown" class="z-10 hidden w-44 bg-white rounded-lg shadow dark:bg-gray-700 border-gray-200">
        <form
                action="{{ path('app_stock_index') }}"
                method="GET"
                data-turbo-frame="stock-list"
                data-controller="stock-filter"
                data-action="stock-filter-list:filterItemDeleted@window->stock-filter#filterItemDeleted"
        >
            <ul class="py-2 text-xs">
                <li>
                    <button data-dropdown-toggle="filterTrend" data-dropdown-placement="right" type="button" class="flex items-center justify-between w-full px-2 py-1.5 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white">
                        Trend
                        <svg class="w-2.5 h-2.5 ms-3 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"></path>
                        </svg>
                    </button>

                    <div id="filterTrend" class="z-10 hidden w-60 bg-white divide-y divide-gray-100 rounded-lg shadow dark:bg-gray-700 dark:divide-gray-600">
                        <ul class="p-1.5 text-xs text-gray-700 dark:text-gray-200" data-stock-filter-target="trendList">
                            {% for trend in trends %}
                                <li class="flex flex-row items-center hover:bg-gray-100 py-1.5 ps-2">
                                    <input data-action="stock-filter#submit" type="checkbox" name="filter[trend][]" value="{{ trend.value }}" class="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 dark:focus:ring-blue-600 dark:ring-offset-gray-700 dark:focus:ring-offset-gray-700 focus:ring-2 dark:bg-gray-600 dark:border-gray-500" />
                                    <label class="ms-2 text-xs font-medium text-gray-900 dark:text-gray-300 truncate ...">{{ trend.value }}</label>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </li>

                <li>
                    <button data-dropdown-toggle="filterComment" data-dropdown-placement="right" type="button" class="flex items-center justify-between w-full px-2 py-1.5 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white">
                        Comment
                        <svg class="w-2.5 h-2.5 ms-3 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"></path>
                        </svg>
                    </button>

                    <div id="filterComment" class="z-10 hidden w-60 bg-white divide-y divide-gray-100 rounded-lg shadow dark:bg-gray-700 dark:divide-gray-600">
                        <ul class="p-3 text-xs text-gray-700 dark:text-gray-200" data-stock-filter-target="commentList">
                            {% for comment in comments %}
                                <li class="flex flex-row items-center hover:bg-gray-100 py-1.5 ps-2">
                                    <input data-action="stock-filter#submit" type="checkbox" name="filter[comment][]" value="{{ comment.value }}" class="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 dark:focus:ring-blue-600 dark:ring-offset-gray-700 dark:focus:ring-offset-gray-700 focus:ring-2 dark:bg-gray-600 dark:border-gray-500" />
                                    <label class="ms-2 text-xs font-medium text-gray-900 dark:text-gray-300 truncate ...">{{ comment.value }}</label>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </li>
            </ul>
        </form>
    </div>

</div>