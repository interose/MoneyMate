<div class="p-2">
    <form
            data-controller="stock-search"
            data-action="stock-filter:stockFilterChanged@window->stock-search#filterChanged keydown.meta+k@window->stock-search#focusSearch keydown.ctrl+k@window->stock-search#focusSearch"
            data-turbo-frame="stock-list"
            action="{{ path('app_stock_index', {...app.request.query.all(), sort: 'industry'}) }}"
            class="flex flex-row"
            method="GET"
    >
        <div class="inline-flex relative max-w-sm me-1">
            <input name="query" type="text" data-stock-search-target="inputQuery" data-action="stock-search#debouncedSubmit" class="p-1 px-2 w-60 text-xs font-medium text-gray-600 rounded bg-gray-50 border border-gray-300 focus:outline-none cursor-pointer" value="" placeholder="Search for name or WKN" />
            <button data-action="click->stock-search#clearQuery" data-stock-search-target="btnReset" type="button" class="hidden absolute inset-y-0 end-0 flex items-center pe-3 text-xs font-medium text-gray-600">
                <svg class="w-4 h-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 7h14m-9 3v8m4-8v8M10 3h4a1 1 0 0 1 1 1v3H9V4a1 1 0 0 1 1-1ZM6 7h12v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7Z"/>
                </svg>
            </button>
            <div data-stock-search-target="btnShortcut" class="absolute inset-y-0 end-0 flex items-center pe-3 text-xs font-medium text-gray-600">&#8984;K</div>
        </div>
        <input type="hidden" name="sort" value="{{ app.request.query.get('sort') }}" />
        <input type="hidden" name="sortDirection" value="{{ app.request.query.get('sortDirection') }}"/>
        <div class="hidden" data-stock-search-target="filterContainer"></div>
    </form>
</div>