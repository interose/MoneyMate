{% extends 'base.html.twig' %}

{% macro sortArrow(sortName, sort, sortDirection) %}
    {% if sort == sortName %}
        sort-{{ sortDirection }}
    {% endif %}
{% endmacro %}

{% block body %}
<!-- Topbar -->
<header class="flex items-center h-14 px-6 gap-4 border-b border-white/[.07] flex-shrink-0">
    <span class="text-[15px] font-semibold tracking-tight">Champions</span>
    <div class="ml-auto flex items-center gap-2">
        {% if get_main_account_id() != 0 %}
            <a
                class="inline-flex items-center gap-[6px] px-[14px] py-[7px] rounded-lg text-[13px] font-medium text-white/70 bg-elevated border border-white/[.07] hover:border-white/[.15] hover:text-white transition-colors cursor-pointer"
                href="{{ path('app_stock_update') }}"
                data-turbo-frame="stock-list"
            >
                <svg id="refreshIcon" class="w-[14px] h-[14px]" viewBox="0 0 14 14" fill="none">
                    <path d="M12 7A5 5 0 1 1 7 2a5 5 0 0 1 3.54 1.46L12 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M12 2v3h-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                Update
            </a>
        {% endif %}
    </div>
</header>

<!-- Filter bar -->
<div class="flex items-center gap-3 px-6 py-[11px] border-b border-white/[.07] flex-shrink-0">
    {% include 'stock/_search.html.twig' %}

    <div class="w-px h-5 bg-white/[.07] flex-shrink-0"></div>

    {% include 'stock/_filter.html.twig' %}

    <span class="ml-auto font-mono text-[12px] text-white/40 whitespace-nowrap">Last Update: <i class="ms-1.5 text-gray-400">{{ lastUpdate }}</i></span>
</div>

<!-- Scrollable table area -->
<div class="scroll-area flex-1 overflow-y-auto px-6 pb-8">
    <turbo-frame
        id="stock-list"
        class="aria-busy:opacity-50 aria-busy:blur-sm transition-all"
    >
        <table class="w-full border-collapse" style="table-layout:fixed">
            <colgroup>
                <col style="width:auto"> <!-- Name -->
{#                <col style="width:88px">  <!-- WKN -->#}
                <col style="width:150px"> <!-- Industry -->
                <col style="width:100px">  <!-- geoPAK10 -->
                <col style="width:80px">  <!-- Profit -->
                <col style="width:90px">  <!-- Loss-Ratio -->
                <col style="width:100px"> <!-- Div. Yield -->
                <col style="width:90px">  <!-- Share Price -->
                <col style="width:80px">  <!-- GD200 -->
                <col style="width:130px"> <!-- Trend -->
                <col style="width:130px">  <!-- Comment -->
            </colgroup>
            <thead class="bg-bg">
            <tr class="border-b border-white/[.07]">
                <th class="sortable py-3 px-3 text-left text-[10.5px] font-semibold tracking-[.07em] uppercase text-white/40 {{ _self.sortArrow('name', sort, sortDirection) }}">
                    <a href="{{ path('app_stock_index', {
                        ...app.request.query.all(),
                        sort: 'name',
                        sortDirection: sort == 'name' and sortDirection == 'asc' ? 'desc' : 'asc',
                    }) }}">
                        Name<span class="sort-arrow"></span>
                    </a>
                </th>
                <th class="sortable py-3 px-3 text-left text-[10.5px] font-semibold tracking-[.07em] uppercase text-white/40 {{ _self.sortArrow('industry', sort, sortDirection) }}">
                    <a href="{{ path('app_stock_index', {
                        ...app.request.query.all(),
                        sort: 'industry',
                        sortDirection: sort == 'industry' and sortDirection == 'asc' ? 'desc' : 'asc',
                    }) }}">
                        Industry<span class="sort-arrow"></span>
                    </a>
                </th>
                <th class="sortable py-3 px-3 text-right text-[10.5px] font-semibold tracking-[.07em] uppercase text-white/40 {{ _self.sortArrow('geoPak10', sort, sortDirection) }}">
                    <a href="{{ path('app_stock_index', {
                        ...app.request.query.all(),
                        sort: 'geoPak10',
                        sortDirection: sort == 'geoPak10' and sortDirection == 'asc' ? 'desc' : 'asc',
                    }) }}">
                        geoPAK10<span class="sort-arrow"></span>
                    </a>
                </th>
                <th class="sortable py-3 px-3 text-right text-[10.5px] font-semibold tracking-[.07em] uppercase text-white/40 {{ _self.sortArrow('profitConsistency', sort, sortDirection) }}">
                    <a href="{{ path('app_stock_index', {
                        ...app.request.query.all(),
                        sort: 'profitConsistency',
                        sortDirection: sort == 'profitConsistency' and sortDirection == 'asc' ? 'desc' : 'asc',
                    }) }}">
                        Profit<span class="sort-arrow"></span>
                    </a>
                </th>
                <th class="sortable py-3 px-3 text-right text-[10.5px] font-semibold tracking-[.07em] uppercase text-white/40 {{ _self.sortArrow('lossRatio', sort, sortDirection) }}">
                    <a href="{{ path('app_stock_index', {
                        ...app.request.query.all(),
                        sort: 'lossRatio',
                        sortDirection: sort == 'lossRatio' and sortDirection == 'asc' ? 'desc' : 'asc',
                    }) }}">
                        Loss-Ratio<span class="sort-arrow"></span>
                    </a>
                </th>
                <th class="sortable py-3 px-3 text-right text-[10.5px] font-semibold tracking-[.07em] uppercase text-white/40 {{ _self.sortArrow('dividendYield', sort, sortDirection) }}">
                    <a href="{{ path('app_stock_index', {
                        ...app.request.query.all(),
                        sort: 'dividendYield',
                        sortDirection: sort == 'dividendYield' and sortDirection == 'asc' ? 'desc' : 'asc',
                    }) }}">
                        Div. Yield<span class="sort-arrow"></span>
                    </a>
                </th>
                <th class="sortable py-3 px-3 text-right text-[10.5px] font-semibold tracking-[.07em] uppercase text-white/40 {{ _self.sortArrow('sharePrice', sort, sortDirection) }}">
                    <a href="{{ path('app_stock_index', {
                        ...app.request.query.all(),
                        sort: 'sharePrice',
                        sortDirection: sort == 'sharePrice' and sortDirection == 'asc' ? 'desc' : 'asc',
                    }) }}">
                        Share Price<span class="sort-arrow"></span>
                    </a>
                </th>
                <th class="sortable py-3 px-3 text-right text-[10.5px] font-semibold tracking-[.07em] uppercase text-white/40 {{ _self.sortArrow('gd200', sort, sortDirection) }}">
                    <a href="{{ path('app_stock_index', {
                        ...app.request.query.all(),
                        sort: 'gd200',
                        sortDirection: sort == 'gd200' and sortDirection == 'asc' ? 'desc' : 'asc',
                    }) }}">
                        GD200<span class="sort-arrow"></span>
                    </a>
                </th>
                <th class="sortable py-3 px-3 text-left text-[10.5px] font-semibold tracking-[.07em] uppercase text-white/40">Trend</th>
                <th class="sortable py-3 px-3 text-left text-[10.5px] font-semibold tracking-[.07em] uppercase text-white/40">Comment</th>
            </tr>
            </thead>
            <tbody>
            {% for champion in champions %}
                <tr class="border-b border-white/[.05] hover:bg-white/[.025] transition-colors">
                    <td class="py-[10px] px-3 text-white font-medium overflow-hidden text-ellipsis whitespace-nowrap">{{ champion.name }}</td>
{#                    <td class="py-[10px] px-3 font-mono text-[12px] text-white/40 overflow-hidden text-ellipsis whitespace-nowrap">{{ champion.wkn }}</td>#}
                    <td class="py-[10px] px-3 text-white/60 text-[12.5px] overflow-hidden text-ellipsis whitespace-nowrap">{{ champion.industry }}</td>
                    <td class="py-[10px] px-3 text-right">
                        <div class="flex items-center justify-end gap-2">
                            <span class="font-mono text-[12px] text-white/70 w-6 text-right">{{ champion.geoPak10 }}</span>
                        </div>
                    </td>
                    <td class="py-[10px] px-3 font-mono text-[12.5px] text-right ${profitCls}">{{ champion.profitConsistency }}</td>
                    <td class="py-[10px] px-3 font-mono text-[12.5px] text-right ${lossCls}">{{ champion.lossRatio }}</td>
                    <td class="py-[10px] px-3 font-mono text-[12.5px] text-right text-white/70">{{ champion.dividendYield }}</td>
                    <td class="py-[10px] px-3 font-mono text-[12.5px] text-right ${priceCls}">{{ champion.sharePrice }}</td>
                    <td class="py-[10px] px-3 font-mono text-[12.5px] text-right ${gd200Cls}">{{ champion.gd200 }}</td>
                    <td class="py-[10px] px-3">
                        <span class="inline-flex items-center gap-[5px] px-[8px] py-[2px] rounded-full text-[11.5px] font-medium {{ champion.trendPill }}">
                            <span class="text-[8px] leading-none">{{ champion.trendIcon }}</span>{{ champion.trend }}
                        </span>
                    </td>
                    <td class="py-[10px] px-3">
                        <span class="inline-flex items-center px-[8px] py-[2px] rounded-full text-[11.5px] font-medium {{ champion.getCommentPillColor }}">
                            {{ champion.comment }}
                        </span>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

    </turbo-frame>
</div>









