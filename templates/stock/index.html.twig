{% extends 'base.html.twig' %}

{% macro sortArrow(sortName, sort, sortDirection) %}
    {% if sort == sortName %}
        {% if sortDirection == 'asc' %}
            <svg xmlns="http://www.w3.org/2000/svg" class="inline-block w-4 h-4" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path d="M6 15l6 -6l6 6"></path>
            </svg>
        {% else %}
            <svg xmlns="http://www.w3.org/2000/svg" class="inline-block w-4 h-4" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path d="M6 9l6 6l6 -6"></path>
            </svg>
        {% endif %}
    {% else %}
        <!-- up and down arrow svg -->
        <svg xmlns="http://www.w3.org/2000/svg" class="inline-block w-4 h-4 text-slate-300" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M8 9l4 -4l4 4"></path>
            <path d="M16 15l-4 4l-4 -4"></path>
        </svg>
    {% endif %}
{% endmacro %}

{% block body %}
    <div class="flex flex-row flex-wrap bg-white border-b border-gray-200 dark:bg-gray-800 dark:border-gray-700">
        {% include 'stock/_search.html.twig' %}

        {% include 'stock/_filter.html.twig' %}

        <div class="flex-1"></div>

        <div class="p-2 flex items-center text-xs font-medium text-center text-gray-600">
            Last Update: <i class="ms-1.5 text-gray-300">{{ lastUpdate }}</i>
        </div>
        <div class="p-2 flex items-center text-xs font-medium text-center text-gray-600">
            <a href="{{ path('app_stock_update') }}" data-turbo-frame="mdl" class="p-1 px-2 me-1 text-xs font-medium text-center inline-flex items-center text-gray-600 rounded bg-gray-100 hover:bg-gray-200 border border-gray-300">
                <svg class="size-4 text-gray-600 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m16 10 3-3m0 0-3-3m3 3H5v3m3 4-3 3m0 0 3 3m-3-3h14v-3"></path>
                </svg>
            </a>
        </div>

        <div class="basis-full"></div>

        {% include 'stock/_filterBreadcrumb.html.twig' %}
    </div>

    <turbo-frame id="stock-list" class="aria-busy:opacity-50 aria-busy:blur-sm transition-all">
        <table class="min-w-full divide-y divide-gray-200 table-fixed dark:divide-gray-600">
            <thead>
            <tr>
            <th scope="col" class="sticky top-0 p-2 text-xs font-medium text-left text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700">
                <div class="flex justify-between">
                    <a href="{{ path('app_stock_index', {
                        ...app.request.query.all(),
                        sort: 'name',
                        sortDirection: sort == 'name' and sortDirection == 'asc' ? 'desc' : 'asc',
                    }) }}">
                        Name {{ _self.sortArrow('name', sort, sortDirection) }}
                    </a>
                </div>
            </th>
            <th scope="col" class="sticky top-0 p-2 text-xs font-medium text-left text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700">WKN</th>
            <th scope="col" class="sticky top-0 p-2 text-xs font-medium text-left text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700">
                <a href="{{ path('app_stock_index', {
                    ...app.request.query.all(),
                    sort: 'industry',
                    sortDirection: sort == 'industry' and sortDirection == 'asc' ? 'desc' : 'asc',
                }) }}">
                    Industry {{ _self.sortArrow('industry', sort, sortDirection) }}
                </a>
            </th>
            <th scope="col" class="sticky top-0 p-2 text-xs font-medium text-left text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700">
                <a href="{{ path('app_stock_index', {
                    ...app.request.query.all(),
                    sort: 'geoPak10',
                    sortDirection: sort == 'geoPak10' and sortDirection == 'asc' ? 'desc' : 'asc',
                }) }}">
                    geoPAK10 {{ _self.sortArrow('geoPak10', sort, sortDirection) }}
                </a>
            </th>
            <th scope="col" class="sticky top-0 p-2 text-xs font-medium text-left text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700">
                <a href="{{ path('app_stock_index', {
                    ...app.request.query.all(),
                    sort: 'profitConsistency',
                    sortDirection: sort == 'profitConsistency' and sortDirection == 'asc' ? 'desc' : 'asc',
                }) }}">
                    Profit {{ _self.sortArrow('profitConsistency', sort, sortDirection) }}
                </a>
            </th>
            <th scope="col" class="sticky top-0 p-2 text-xs font-medium text-left text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700">
                <a href="{{ path('app_stock_index', {
                    ...app.request.query.all(),
                    sort: 'lossRatio',
                    sortDirection: sort == 'lossRatio' and sortDirection == 'asc' ? 'desc' : 'asc',
                }) }}">
                    Loss-Ratio {{ _self.sortArrow('lossRatio', sort, sortDirection) }}
                </a>
            </th>
            <th scope="col" class="sticky top-0 p-2 text-xs font-medium text-left text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700">
                <a href="{{ path('app_stock_index', {
                    ...app.request.query.all(),
                    sort: 'dividendYield',
                    sortDirection: sort == 'dividendYield' and sortDirection == 'asc' ? 'desc' : 'asc',
                }) }}">
                    Dividend Yield {{ _self.sortArrow('dividendYield', sort, sortDirection) }}
                </a>
            </th>
            <th scope="col" class="sticky top-0 p-2 text-xs font-medium text-left text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700">
                <a href="{{ path('app_stock_index', {
                    ...app.request.query.all(),
                    sort: 'sharePrice',
                    sortDirection: sort == 'sharePrice' and sortDirection == 'asc' ? 'desc' : 'asc',
                }) }}">
                    Share Price {{ _self.sortArrow('sharePrice', sort, sortDirection) }}
                </a>
            </th>
            <th scope="col" class="sticky top-0 p-2 text-xs font-medium text-left text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700">
                <a href="{{ path('app_stock_index', {
                    ...app.request.query.all(),
                    sort: 'gd200',
                    sortDirection: sort == 'gd200' and sortDirection == 'asc' ? 'desc' : 'asc',
                }) }}">
                    GD200 {{ _self.sortArrow('gd200', sort, sortDirection) }}
                </a>
            </th>
            <th scope="col" class="sticky top-0 p-2 text-xs font-medium text-left text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700">
                <a href="{{ path('app_stock_index', {
                    ...app.request.query.all(),
                    sort: 'trend',
                    sortDirection: sort == 'trend' and sortDirection == 'asc' ? 'desc' : 'asc',
                }) }}">
                    Trend {{ _self.sortArrow('trend', sort, sortDirection) }}
                </a>
            </th>
            <th scope="col" class="sticky top-0 p-2 text-xs font-medium text-left text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700">
                <a href="{{ path('app_stock_index', {
                    ...app.request.query.all(),
                    sort: 'comment',
                    sortDirection: sort == 'comment' and sortDirection == 'asc' ? 'desc' : 'asc',
                }) }}">
                    Comment {{ _self.sortArrow('comment', sort, sortDirection) }}
                </a>
            </th>
        </tr>
         </thead>
            <tbody class="bg-white divide-y divide-gray-200 dark:bg-gray-800 dark:divide-gray-700">
            {% for champion in champions %}
                <tr class="odd:bg-white odd:dark:bg-gray-900 even:bg-gray-50 even:dark:bg-gray-800 border-b dark:border-gray-700 hover:bg-yellow-100 dark:hover:bg-gray-600">
                    <td class="p-1 px-2 text-xs font-normal text-gray-600 whitespace-nowrap dark:text-gray-400">{{ champion.name }}</td>
                    <td class="p-1 px-2 text-xs font-normal text-gray-600 whitespace-nowrap dark:text-gray-400">{{ champion.wkn }}</td>
                    <td class="p-1 px-2 text-xs font-normal text-gray-600 whitespace-nowrap dark:text-gray-400">{{ champion.industry }}</td>
                    <td class="p-1 px-2 text-xs font-normal text-gray-600 whitespace-nowrap dark:text-gray-400">{{ champion.geoPak10 }}</td>
                    <td class="p-1 px-2 text-xs font-normal text-gray-600 whitespace-nowrap dark:text-gray-400">{{ champion.profitConsistency }}</td>
                    <td class="p-1 px-2 text-xs font-normal text-gray-600 whitespace-nowrap dark:text-gray-400">{{ champion.lossRatio }}</td>
                    <td class="p-1 px-2 text-xs font-normal text-gray-600 whitespace-nowrap dark:text-gray-400">{{ champion.dividendYield }}</td>
                    <td class="p-1 px-2 text-xs font-normal text-gray-600 whitespace-nowrap dark:text-gray-400">{{ champion.sharePrice }}</td>
                    <td class="p-1 px-2 text-xs font-normal text-gray-600 whitespace-nowrap dark:text-gray-400">{{ champion.gd200 }}</td>
                    <td class="p-1 px-2 text-xs font-normal text-gray-600 whitespace-nowrap dark:text-gray-400">{{ champion.trend }}</td>
                    <td class="p-1 px-2 text-xs font-normal text-gray-600 whitespace-nowrap dark:text-gray-400">{{ champion.comment }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="11" class="p-4 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-400">No records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </turbo-frame>
{% endblock %}
