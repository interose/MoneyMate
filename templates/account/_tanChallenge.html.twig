<div
    data-controller="account-tan-poll"
    data-account-tan-poll-url-value="{{ path('app_account_tan_poll', {id: account.id}) }}"
    data-account-tan-poll-allows-automated-polling-value="{{ challenge.allowsAutomatedPolling ? '1' : '' }}"
    data-account-tan-poll-first-delay-value="{{ challenge.firstDecoupledCheckDelaySeconds }}"
    data-account-tan-poll-periodic-delay-value="{{ challenge.periodicDecoupledCheckDelaySeconds }}"
    data-account-tan-poll-max-checks-value="{{ challenge.maxDecoupledChecks }}"
    class="flex flex-col items-center gap-4 px-6 py-10 text-center"
>
    <div class="w-12 h-12 rounded-full flex items-center justify-center shrink-0" style="background:rgba(91,138,245,.12);color:#5b8af5">
        <svg class="w-6 h-6" viewBox="0 0 16 16" fill="none"><rect x="4" y="1.5" width="8" height="13" rx="1.3" stroke="currentColor" stroke-width="1.3"/><path d="M7 12.3h2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
    </div>

    <div class="max-w-sm">
        <p class="text-[13px] leading-relaxed" style="color:var(--tx)">{{ challenge.message|nl2br }}</p>
        {% if challenge.tanMediumName %}
            <p class="text-[11px] text-muted font-mono mt-2">TAN medium: {{ challenge.tanMediumName }}</p>
        {% endif %}
    </div>

    <div class="flex items-center gap-2 text-[12px] text-muted">
        <span class="inline-block w-3 h-3 rounded-full border-2 shrink-0 animate-spin" style="border-color:var(--border-hi);border-top-color:#5b8af5"></span>
        <span data-account-tan-poll-target="status">Waiting for confirmation on your phone…</span>
    </div>

    <button type="button" hidden
        data-action="account-tan-poll#manualCheck"
        data-account-tan-poll-target="manualButton"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-[13px] font-medium cursor-pointer transition-all hover:-translate-y-px"
        style="background:var(--raised);border:1px solid var(--border);color:var(--tx)"
    >
        I've confirmed — check now
    </button>
</div>
