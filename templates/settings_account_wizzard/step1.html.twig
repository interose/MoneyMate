{% extends 'base.html.twig' %}

{% block body %}
    <twig:Header title="Add Account"></twig:Header>

    <div class="grid grid-cols-8 gap-4 px-4 pt-6 dark:bg-gray-900">
        <twig:Card grid="col-span-8 xl:col-start-2 xl:col-end-8">
            <twig:AccountWizzardStepper currentStep="1" :account="account" />

            {{ form_start(form) }}

            <div class="grid grid-cols-2 gap-4">
                <div class="col-span-2">{{ form_row(form.name) }}</div>
                <div>{{ form_row(form.bic) }}</div>
                <div>{{ form_row(form.bankCode) }}</div>
                <div class="col-span-2">{{ form_row(form.url) }}</div>
            </div>

            <div class="flex justify-end">
                <button class="text-white bg-green-700 hover:bg-green-800 focus:outline-none font-medium rounded-lg text-sm px-5 py-2 text-center mt-4 inline-flex items-center">
                    <i class="fa-solid fa-floppy-disk me-2.5"></i>{% if account.isFinal %}Save{% else %}Next{% endif %}
                </button>
            </div>

            {{ form_end(form) }}
        </twig:Card>
    </div>
{% endblock %}
