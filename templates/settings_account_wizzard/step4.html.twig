{% extends 'base.html.twig' %}

{% block body %}
    <twig:Header title="Add Account"></twig:Header>

    <div class="grid grid-cols-8 gap-4 px-4 pt-6 dark:bg-gray-900">
        <twig:Card grid="col-span-8 xl:col-start-2 xl:col-end-8">
            <twig:AccountWizzardStepper currentStep="4" :account="account" />

            <h5 class="inline-flex items-center mb-6 text-base font-semibold text-gray-700 dark:text-gray-400">Found and stored the following subaccounts:</h5>

            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-600">
                <thead>
                <tr>
                    <th scope="col" class="p-2 text-xs font-medium text-left text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700">IBAN</th>
                    <th scope="col" class="p-2 text-xs font-medium text-left text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700">Account Number</th>
                    <th scope="col" class="p-2 text-xs font-medium text-center text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700">Enabled</th>
                    <th scope="col" class="p-2 text-xs font-medium text-left text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700">Description</th>
                </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200 dark:bg-gray-800 dark:divide-gray-700">
                {% for subAccount in subAccounts %}
                    <tr class="odd:bg-white odd:dark:bg-gray-900 even:bg-gray-50 even:dark:bg-gray-800 border-b dark:border-gray-700 hover:bg-yellow-100 dark:hover:bg-gray-600">
                        <td class="p-1 px-2 text-xs font-normal text-gray-600 whitespace-nowrap dark:text-gray-400">{{ subAccount.iban }}</td>
                        <td class="p-1 px-2 text-xs font-normal text-gray-600 whitespace-nowrap dark:text-gray-400">{{ subAccount.accountNumber }}</td>
                        <td class="p-1 px-2 text-xs font-normal text-gray-600 flex justify-center whitespace-nowrap dark:text-gray-400">
                            {% if subAccount.enabled %}
                                <i class="text-emerald-700 fa-solid fa-circle-check"></i>
                            {% else %}
                                <i class="text-red-700 fa-solid fa-circle-xmark"></i>
                            {% endif %}
                        </td>
                        <td class="p-1 px-2 text-xs font-normal text-gray-600 whitespace-nowrap dark:text-gray-400">{{ subAccount.description }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="p-4 text-xs font-medium text-left text-gray-500 uppercase dark:text-gray-400">No records found</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

            <h5 class="inline-flex items-center mt-10 mb-2 text-base font-semibold text-gray-700 dark:text-gray-400">Optional:</h5>

            <p class="text-sm text-gray-600 mb-6">Optionally, you can upload the bank's logo and the background color for the logo.</p>

            {{ form_start(form) }}

            <div class="grid grid-cols-2 gap-4">
                <div class="">
                    <label for="{{ form.logoFile.vars.id }}" class="text-xs text-gray-600 dark:text-gray-400 inline-flex">{{ form.logoFile.vars.label }}</label>
                    {{ form_widget(form.logoFile, {'attr': {'class': 'block w-full text-sm text-gray-900 border border-gray-300 rounded-lg cursor-pointer bg-gray-50 dark:text-gray-400 focus:outline-none dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400'}}) }}
                    {{ form_help(form.logoFile) }}
                </div>

                <div class="flex flex-row gap-4">
                    <div class="">
                        <label for="{{ form.foregroundColor.vars.id }}" class="text-xs text-gray-600 dark:text-gray-400 inline-flex">{{ form.foregroundColor.vars.label }}</label>
                        {{ form_widget(form.foregroundColor, {'attr': {'class': 'p-1 h-10 w-14 mx-auto block bg-white border border-gray-200 cursor-pointer rounded-lg disabled:opacity-50 disabled:pointer-events-none dark:bg-neutral-900 dark:border-neutral-700'}}) }}
                        {{ form_help(form.foregroundColor) }}
                    </div>

                    <div class="">
                        <label for="{{ form.backgroundColor.vars.id }}" class="text-xs text-gray-600 dark:text-gray-400 inline-flex">{{ form.backgroundColor.vars.label }}</label>
                        {{ form_widget(form.backgroundColor, {'attr': {'class': 'p-1 h-10 w-14 mx-auto block bg-white border border-gray-200 cursor-pointer rounded-lg disabled:opacity-50 disabled:pointer-events-none dark:bg-neutral-900 dark:border-neutral-700'}}) }}
                        {{ form_help(form.backgroundColor) }}
                    </div>
                </div>
            </div>

            <div class="flex justify-end">
                <button class="text-white bg-green-700 hover:bg-green-800 focus:outline-none font-medium rounded-lg text-sm px-5 py-2 text-center mt-4 inline-flex items-center">
                    <i class="fa-solid fa-floppy-disk me-2.5"></i>Update
                </button>
            </div>
            {{ form_end(form) }}
        </twig:Card>
    </div>
{% endblock %}
