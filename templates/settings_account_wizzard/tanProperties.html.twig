{% extends 'base.html.twig' %}

{% block body %}
    <twig:Header title="Add Account"></twig:Header>

    <div class="grid grid-cols-6 gap-4 px-4 pt-6 dark:bg-gray-900">
        <twig:Card grid="col-start-2 col-end-6">
            <twig:AccountWizzardStepper currentStep="3" />

            <turbo-frame id="tan-properties" class="aria-busy:opacity-50 transition-opacity">
                {{ form_start(form, {'attr': {'data-account-wizzard-target': 'form'}}) }}

                <div class="grid grid-cols-2 gap-4">
                    <div>{{ form_row(form.tanMode, {'attr': {'data-action': 'account-wizzard#submit'}}) }}</div>
                    <div>{{ form_row(form.tanMedium) }}</div>
                </div>

                <div class="flex justify-between">
                    <a
                        class="text-gray-900 bg-gray-100 hover:bg-gray-200 focus:outline-none font-medium rounded-lg text-sm px-5 py-2 text-center mt-4 inline-flex items-center"
                        href="{{ path('app_settings_account_step1', {'id': account.id}) }}"
                    >
                        back
                    </a>
                    <button class="text-white bg-green-700 hover:bg-green-800 focus:outline-none font-medium rounded-lg text-sm px-5 py-2 text-center mt-4 inline-flex items-center">
                        <i class="fa-solid fa-floppy-disk me-2.5"></i>{{ button_label|default('Save') }}
                    </button>
                </div>

                {{ form_end(form) }}
            </turbo-frame>


        </twig:Card>
    </div>
{% endblock %}
