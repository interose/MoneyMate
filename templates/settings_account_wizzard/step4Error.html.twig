{% extends 'base.html.twig' %}

{% block body %}
    <twig:Header title="Add Account"></twig:Header>

    <div class="grid grid-cols-8 gap-4 px-4 pt-6 dark:bg-gray-900">
        <twig:Card grid="col-span-8 xl:col-start-2 xl:col-end-8">
            <twig:AccountWizzardStepper currentStep="4" />

            <div class="p-4 mb-6 text-sm text-red-800 rounded-lg bg-red-50 dark:bg-gray-800 dark:text-red-400" role="alert">
                <span class="font-medium"><b>Communication Error:</b><br></span>
                {{ error|raw }}<br><br>
            </div>

            <div class="flex justify-end">
                <a
                    class="text-white bg-green-700 hover:bg-green-800 focus:outline-none font-medium rounded-lg text-sm px-5 py-2 text-center mt-4 inline-flex items-center"
                    href="{{ path('app_settings_account_index') }}"
                >
                    Finish
                </a>
            </div>

        </twig:Card>
    </div>
{% endblock %}
