{{ form_start(form) }}
    <div class="flex flex-col gap-4 px-[22px] py-5">
        {{ form_row(form.name) }}

        {% if app.request.query.get('groupId') %}
            {{ form_widget(form.categoryGroup, {'attr': {'style': 'display:none'}}) }}
        {% else %}
            {{ form_row(form.categoryGroup) }}
        {% endif %}

        <div class="flex flex-col gap-3">
            <label class="text-[11.5px] font-medium text-white/40">Options</label>

            <!-- TreeIgnore toggle -->
            <div class="flex items-center justify-between px-3 py-[10px] bg-elevated rounded-lg border border-white/[.07]">
                <div class="flex flex-col gap-[2px]">
                    <span class="text-[13px] text-white/80">Tree Ignore</span>
                    <span class="text-[11.5px] text-white/35">Hide category in tree view</span>
                </div>

                <label class="toggle">
                    {{ form_widget(form.treeIgnore) }}
                    <span class="toggle-slider"></span>
                </label>
            </div>

            <!-- DashboardIgnore toggle -->
            <div class="flex items-center justify-between px-3 py-[10px] bg-elevated rounded-lg border border-white/[.07]">
                <div class="flex flex-col gap-[2px]">
                    <span class="text-[13px] text-white/80">Dashboard Ignore</span>
                    <span class="text-[11.5px] text-white/35">Do not display category in dashboard</span>
                </div>
                <label class="toggle">
                    {{ form_widget(form.dashboardIgnore) }}
                    <span class="toggle-slider"></span>
                </label>
            </div>
        </div>
    </div>

    <div class="flex justify-end gap-2 px-[22px] py-4 border-t border-white/[.07]">
        <button class="grad inline-flex items-center px-[14px] py-[7px] rounded-lg text-[13px] font-medium text-white shadow-[0_3px_12px_rgba(67,72,224,.3)] hover:opacity-90 transition-opacity cursor-pointer border-0">
            {{ button_label|default('Save') }}
        </button>
    </div>
{{ form_end(form) }}
