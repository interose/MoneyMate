{% extends 'base.html.twig' %}

{% block body %}
<turbo-frame id="category-panel">
    <!-- Detail panel -->
    <div
        data-category-manager-target="detailPanel"
        class="flex flex-col flex-1 overflow-hidden"
    >
        <!-- Group edit bar -->
        {% include 'settings_category_group/_editBar.html.twig' with { 'group': group } %}

        <!-- Categories subheader -->
        <div class="flex items-center justify-between px-6 py-3 border-b border-white/[.07] flex-shrink-0">
            <span class="text-[11px] font-semibold tracking-[.07em] uppercase text-white/40">Categories</span>
            <a
                href="{{ path('app_settings_category_new', {'id': group.id}) }}"
                class="inline-flex items-center gap-[5px] text-[12px] font-medium text-accent hover:text-white transition-colors cursor-pointer border-0 bg-transparent"
                data-turbo-frame="mdl"
                data-modal-width="400px"
            >
                <svg class="w-[13px] h-[13px]" viewBox="0 0 13 13" fill="none"><path d="M6.5 2v9M2 6.5h9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
                Add category
            </a>
        </div>

        <!-- Categories list -->
        <div class="scroll-area flex-1 overflow-y-auto" id="categoryList">

            {% for category in categories %}
                <div
                    class="group flex items-center gap-4 px-6 py-[11px] border-b border-white/[.05] hover:bg-white/[.025] transition-colors"
                    id="category-list-item-{{ category.id }}"
                >
                    {% include 'settings_category/_row.html.twig' with { 'category': category } %}
                </div>
            {% else %}
                <div class="flex flex-col items-center justify-center h-32 gap-2">
                    <p class="text-[12.5px] text-white/25">No categories yet</p>
                </div>
            {% endfor %}
        </div>
    </div>
</turbo-frame>
{% endblock %}
