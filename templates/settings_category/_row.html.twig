<span class="text-[13px] font-medium flex-1 text-white/80 truncate">{{ category.name }}</span>

<!-- TreeIgnore badge -->
<div class="flex items-center gap-[6px]">
    {% if category.isDashboardIgnore %}
        <span class="inline-flex items-center gap-[4px] px-2 py-[2px] rounded-full text-[11px] font-medium bg-white/[.06] text-white/35">
                            <svg class="w-[9px] h-[9px]" viewBox="0 0 10 10" fill="none"><path d="M1.5 1.5l7 7M8.5 1.5l-7 7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path></svg>
                            Dashboard
                        </span>
    {% else %}
        <span class="inline-flex items-center gap-[4px] px-2 py-[2px] rounded-full text-[11px] font-medium text-white/20">Dashboard</span>
    {% endif %}


    {% if category.isTreeIgnore %}
        <span class="inline-flex items-center gap-[4px] px-2 py-[2px] rounded-full text-[11px] font-medium bg-white/[.06] text-white/35">
                            <svg class="w-[9px] h-[9px]" viewBox="0 0 10 10" fill="none"><path d="M1.5 1.5l7 7M8.5 1.5l-7 7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path></svg>
                            Tree
                        </span>
    {% else %}
        <span class="inline-flex items-center gap-[4px] px-2 py-[2px] rounded-full text-[11px] font-medium text-white/20">Tree</span>
    {% endif %}
</div>

<!-- category pill preview -->
<span class="text-[11.5px] font-medium px-[9px] py-[2px] rounded-full flex-shrink-0" style="background:rgba(139,92,246,0.1);color:#8b5cf6;border:1px solid rgba(139,92,246,0.25)">{{ category.name }}</span>

<!-- actions (visible on hover) -->
<div class="flex items-center gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
    <a
        href="{{ path('app_settings_category_edit', {'id': category.id}) }}"
        class="flex items-center justify-center w-7 h-7 rounded-md text-white/30 hover:text-white hover:bg-white/[.07] transition-colors cursor-pointer border-0 bg-transparent"
        data-turbo-frame="mdl"
        data-modal-width="400px"
    >
        <svg class="w-[13px] h-[13px]" viewBox="0 0 13 13" fill="none"><path d="M8.5 2.5l2 2-6 6H2.5v-2l6-6z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </a>

    <form method="post" action="{{ path('app_settings_category_delete', {'id': category.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
        <button class="flex items-center justify-center w-7 h-7 rounded-md text-white/30 hover:text-pink hover:bg-pink/10 transition-colors cursor-pointer border-0 bg-transparent">
            <svg class="w-[13px] h-[13px]" viewBox="0 0 13 13" fill="none"><path d="M2.5 3.5h8M5 3.5V2.5h3v1M5.5 5.5v4M7.5 5.5v4M3 3.5l.5 7h6l.5-7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
    </form>
</div>
