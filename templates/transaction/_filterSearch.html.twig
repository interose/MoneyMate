<!-- Search -->
<div class="relative flex-shrink-0">
    <div class="flex items-center gap-[7px] bg-elevated border border-white/[.07] rounded-lg pl-3 pr-2 py-[6px] w-[220px] focus-within:border-accent transition-colors">
        <!-- Search icon -->
        <svg class="w-[13px] h-[13px] opacity-40 flex-shrink-0" viewBox="0 0 13 13" fill="none">
            <circle cx="5.5" cy="5.5" r="4" stroke="currentColor" stroke-width="1.3"/>
            <path d="M9 9l2.5 2.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
        </svg>

        <!-- Input -->
        <input
            type="search"
            placeholder="Search …"
            data-ta-filter-target="searchQuery"
            data-action="ta-filter#debouncedSubmit"
            class="bg-transparent border-none outline-none text-white font-sans text-[13px] w-full placeholder:text-white/40 min-w-0"
        >

        <!-- Clear button — hidden by default -->
        <button
            data-action="click->ta-filter#clearSearchQuery"
            data-ta-filter-target="searchQueryReset"
            class="hidden flex-shrink-0 flex items-center justify-center w-[18px] h-[18px] rounded-md text-white/30 hover:text-white hover:bg-white/[.08] transition-colors cursor-pointer border-0 bg-transparent"
        >
            <svg width="11" height="11" viewBox="0 0 11 11" fill="none">
                <path d="M2 2l7 7M9 2l-7 7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            </svg>
        </button>

        <!-- Shortcut badge — visible when input is empty -->
        <span data-ta-filter-target="searchQueryShortcut"
              class="flex-shrink-0 font-mono text-[14px] text-white/20 leading-none tracking-tight select-none"
        >
          &#8984;K
        </span>
    </div>
</div>
