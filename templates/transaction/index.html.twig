{% extends 'base.html.twig' %}

{% macro sortArrow(sortName, sort, sortDirection) %}
    {% if sort == sortName %}
        {% if sortDirection == 'asc' %}
            <svg xmlns="http://www.w3.org/2000/svg" class="inline-block w-4 h-4" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path d="M6 15l6 -6l6 6"></path>
            </svg>
        {% else %}
            <svg xmlns="http://www.w3.org/2000/svg" class="inline-block w-4 h-4" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path d="M6 9l6 6l6 -6"></path>
            </svg>
        {% endif %}
    {% else %}
        <!-- up and down arrow svg -->
        <svg xmlns="http://www.w3.org/2000/svg" class="inline-block w-4 h-4 text-slate-300" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
            <path d="M8 9l4 -4l4 4"></path>
            <path d="M16 15l-4 4l-4 -4"></path>
        </svg>
    {% endif %}
{% endmacro %}

{% block body %}
<!-- Filter bar -->
<div class="flex items-center gap-2 px-6 py-[11px] border-b border-white/[.07] flex-shrink-0 flex-wrap">

    <!-- Search -->
    <div class="flex items-center gap-[7px] bg-elevated border border-white/[.07] rounded-lg px-3 py-[6px] w-[200px] focus-within:border-accent transition-colors">
        <svg class="w-[13px] h-[13px] opacity-40 flex-shrink-0" viewBox="0 0 13 13" fill="none">
            <circle cx="5.5" cy="5.5" r="4" stroke="currentColor" stroke-width="1.3"/>
            <path d="M9 9l2.5 2.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
        </svg>
        <input id="searchInput" type="text" placeholder="Suchen …" class="bg-transparent border-none outline-none text-white font-sans text-[13px] w-full placeholder:text-white/40" >
    </div>

    <span id="filterCount" class="ml-auto font-mono text-[12px] text-white/40 whitespace-nowrap">{{ transactions|length }} Entries</span>
</div>

<!-- Scrollable table area -->
<div class="scroll-area flex-1 overflow-y-auto px-6 pb-8">
    <turbo-frame
        id="transaction-list"
        class="aria-busy:opacity-50 aria-busy:blur-sm transition-all dropdown-manager"
        data-controller="ta-dropdown-manager"
        data-ta-dropdown-manager-update-url-value="{{ path('app_transaction_set_category') }}"
    >

    <table class="w-full border-collapse" style="table-layout:fixed">
        <colgroup>
            <col class="c-date">
            <col class="c-receiver">
            <col class="c-category">
            <col class="c-amount">
        </colgroup>
        <thead class="bg-bg">
            <tr class="border-b border-white/[.07]">
                <th class="py-3 px-3 text-left text-[10.5px] font-semibold tracking-[.07em] uppercase text-white/40">Datum</th>
                <th class="py-3 px-3 text-left text-[10.5px] font-semibold tracking-[.07em] uppercase text-white/40">Empfänger / Sender</th>
                <th class="py-3 px-3 text-left text-[10.5px] font-semibold tracking-[.07em] uppercase text-white/40">Kategorie</th>
                <th class="py-3 px-3 text-right text-[10.5px] font-semibold tracking-[.07em] uppercase text-white/40">Betrag</th>
            </tr>
        </thead>
        <tbody>
        {% for transaction in transactions %}
            {% if transaction.hasSplitTransactions %}
            {% else %}
                <tr
                    class="data-row border-b border-white/[.07] hover:bg-white/[.025] transition-colors"
                    id="transaction-list-item-{{ transaction.id }}"
                >
                    {% include 'transaction/_row.html.twig' with { 'transaction': transaction } %}
                </tr>
            {% endif %}
        {% endfor %}
        </tbody>
    </table>
    </turbo-frame>
</div>
{% endblock %}
