<div
    data-{{ controller }}-target="dropdown"
    class="fixed z-[300] w-[240px] bg-card border border-white/[.12] rounded-xl shadow-[0_12px_36px_rgba(0,0,0,.55)] overflow-hidden hidden"
>
    <!-- Search -->
    <div class="p-2 border-b border-white/[.07]">
        <div class="flex items-center gap-2 bg-elevated border border-white/[.07] rounded-lg px-2 py-[5px] focus-within:border-accent transition-colors">
            <svg class="w-3 h-3 opacity-30 flex-shrink-0" viewBox="0 0 12 12" fill="none">
                <circle cx="5" cy="5" r="3.5" stroke="currentColor" stroke-width="1.3"/>
                <path d="M8 8l2 2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            </svg>
            <input
                type="text"
                placeholder="Search …"
                class="bg-transparent border-none outline-none text-white font-sans text-[12px] w-full placeholder:text-white/30"
                data-{{ controller }}-target="search"
                data-action="keyup->{{ controller }}#handleKeyNavigation keydown->{{ controller }}#handleEscape"
            >
        </div>
    </div>
    <!-- Items -->
    <div id="catList" class="max-h-52 overflow-y-auto py-1 scroll-area">
        {% for group in categoryGroups %}
            <div class="px-3 pt-2 pb-[3px] text-[10px] font-semibold tracking-[.07em] uppercase text-white/30">{{ group.groupName }}</div>
            {% for category in group.categories %}
                <button
                    class="w-full text-left px-3 py-[7px] text-[12.5px] text-white/70 hover:bg-white/[.05] hover:text-white transition-colors cursor-pointer border-0 bg-transparent"
                    data-{{ controller }}-target="catItem"
                    data-action="click->{{ controller }}#selectCategory"
                    data-category-id="{{ category.id }}"
                >
                    {{ category.name }}
                </button>
            {% endfor %}
        {% endfor %}
    </div>
</div>
