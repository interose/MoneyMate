<div
    data-ta-dropdown-manager-target="dropdown"
    class="bg-white border border-slate-200 rounded-md shadow-xl overflow-hidden hidden dropdown-content"
>
    <div class="p-2 border-b border-slate-100 bg-slate-50">
        <input
            type="text"
            placeholder="Search..."
            class="w-full text-[11px] border border-slate-200 rounded px-2 py-1 focus:ring-1 focus:ring-blue-400 outline-none"
            data-ta-dropdown-manager-target="search"
            data-action="keyup->ta-dropdown-manager#handleKeyNavigation keydown->ta-dropdown-manager#handleEscape"
        >
    </div>
    <div class="max-h-48 overflow-y-auto py-1" id="dropdown-list">
        {% for group in categoryGroups %}
                {% for category in group.categories %}
                    <button
                        class="cat-item w-full text-left px-2 py-1.5 text-[12px] text-slate-600 hover:bg-blue-50 hover:text-blue-700 transition-colors"
                        data-ta-dropdown-manager-target="catItem"
                        data-action="click->ta-dropdown-manager#selectCategory"
                        data-category-id="{{ category.id }}"
                    >
                        {{ group.groupName }}:{{ category.name }}
                    </button>
                {% endfor %}
        {% endfor %}
    </div>
</div>