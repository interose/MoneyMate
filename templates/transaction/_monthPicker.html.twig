<!-- Month Picker -->
<div class="relative flex-shrink-0">
    <div class="flex items-center gap-1">

        <!-- Prev month -->
        <button
            data-action="click->ta-filter#prevMonth"
            class="flex items-center justify-center w-7 h-7 rounded-lg text-white/40 hover:text-white hover:bg-white/[.06] transition-colors cursor-pointer border-0 bg-transparent"
        >
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M8.5 3L5 7l3.5 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>

        <!-- Label — click opens dropdown -->
        <div
            class="flex items-center gap-[6px] px-3 py-[5px] rounded-lg bg-elevated border border-white/[.07] hover:border-white/[.15] transition-colors cursor-pointer text-[13px] font-medium text-white min-w-[130px] justify-center"
            data-action="click->ta-filter#togglePickerDropdown"
        >
            <span data-ta-filter-target="pickerLabel">{{ month|month_abbr }} {{ year }}</span>
            <svg data-ta-filter-target="pickerChevron" class="w-3 h-3 text-white/40 transition-transform duration-150" viewBox="0 0 12 12" fill="none">
                <path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>

        <input name="month" type="hidden" data-ta-filter-target="month" value="{{ month }}" />
        <input name="year" type="hidden" data-ta-filter-target="year" value="{{ year }}" />

        <!-- Next month -->
        <button
            data-action="click->ta-filter#nextMonth"
            class="flex items-center justify-center w-7 h-7 rounded-lg text-white/40 hover:text-white hover:bg-white/[.06] transition-colors cursor-pointer border-0 bg-transparent"
        >
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M5.5 3L9 7l-3.5 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>
    </div>

    <!-- Dropdown -->
    <div
        class="absolute top-[calc(100%+6px)] left-1/2 -translate-x-1/2 w-[224px] bg-card border border-white/[.12] rounded-xl shadow-[0_12px_36px_rgba(0,0,0,.5)] z-[200] overflow-hidden hidden"
        data-ta-filter-target="pickerDropdown"
    >
        <!-- Year row -->
        <div class="flex items-center justify-between px-3 py-[10px] border-b border-white/[.07]" data-ta-filter-target="yearOverviewCol">
            <div
                data-action="click->ta-filter#pickerPrevYear"
                class="flex items-center justify-center w-6 h-6 rounded-md text-white/40 hover:text-white hover:bg-white/[.06] transition-colors cursor-pointer border-0 bg-transparent"
            >
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M7.5 2.5L4.5 6l3 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
            <span data-ta-filter-target="dropdownYearLabel" class="text-[13px] font-semibold text-white">{{ year }}</span>
            <div
                data-action="click->ta-filter#pickerNextYear"
                class="flex items-center justify-center w-6 h-6 rounded-md text-white/40 hover:text-white hover:bg-white/[.06] transition-colors cursor-pointer border-0 bg-transparent"
            >
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                    <path d="M4.5 2.5L7.5 6l-3 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
        </div>

        <!-- Month grid -->
        <div data-ta-filter-target="dropdownMonths" class="grid grid-cols-4 gap-1 p-2">
            <button class="py-[6px] rounded-lg text-[12px] font-medium cursor-pointer border-0 transition-colors text-white/25 hover:bg-white/[.08]  bg-transparent" data-action="click->ta-filter#dropdownSelectMonth" data-value="1">Jan</button>
            <button class="py-[6px] rounded-lg text-[12px] font-medium cursor-pointer border-0 transition-colors text-white/25 hover:bg-white/[.08]  bg-transparent" data-action="click->ta-filter#dropdownSelectMonth" data-value="2">Feb</button>
            <button class="py-[6px] rounded-lg text-[12px] font-medium cursor-pointer border-0 transition-colors text-white/25 hover:bg-white/[.08]  bg-transparent" data-action="click->ta-filter#dropdownSelectMonth" data-value="3">Mär</button>
            <button class="py-[6px] rounded-lg text-[12px] font-medium cursor-pointer border-0 transition-colors text-white/25 hover:bg-white/[.04] bg-transparent" data-action="click->ta-filter#dropdownSelectMonth" data-value="4">Apr</button>
            <button class="py-[6px] rounded-lg text-[12px] font-medium cursor-pointer border-0 transition-colors text-white/25 hover:bg-white/[.04] bg-transparent" data-action="click->ta-filter#dropdownSelectMonth" data-value="5">Mai</button>
            <button class="py-[6px] rounded-lg text-[12px] font-medium cursor-pointer border-0 transition-colors text-white/25 hover:bg-white/[.04] bg-transparent" data-action="click->ta-filter#dropdownSelectMonth" data-value="6">Jun</button>
            <button class="py-[6px] rounded-lg text-[12px] font-medium cursor-pointer border-0 transition-colors text-white/25 hover:bg-white/[.04] bg-transparent" data-action="click->ta-filter#dropdownSelectMonth" data-value="7">Jul</button>
            <button class="py-[6px] rounded-lg text-[12px] font-medium cursor-pointer border-0 transition-colors text-white/25 hover:bg-white/[.04] bg-transparent" data-action="click->ta-filter#dropdownSelectMonth" data-value="8">Aug</button>
            <button class="py-[6px] rounded-lg text-[12px] font-medium cursor-pointer border-0 transition-colors text-white/25 hover:bg-white/[.04] bg-transparent" data-action="click->ta-filter#dropdownSelectMonth" data-value="9">Sep</button>
            <button class="py-[6px] rounded-lg text-[12px] font-medium cursor-pointer border-0 transition-colors text-white/25 hover:bg-white/[.04] bg-transparent" data-action="click->ta-filter#dropdownSelectMonth" data-value="10">Okt</button>
            <button class="py-[6px] rounded-lg text-[12px] font-medium cursor-pointer border-0 transition-colors text-white/25 hover:bg-white/[.04] bg-transparent" data-action="click->ta-filter#dropdownSelectMonth" data-value="11">Nov</button>
            <button class="py-[6px] rounded-lg text-[12px] font-medium cursor-pointer border-0 transition-colors text-white/25 hover:bg-white/[.04] bg-transparent" data-action="click->ta-filter#dropdownSelectMonth" data-value="12">Dez</button>
        </div>
    </div>
</div>
