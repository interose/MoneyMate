<td class="p-1 px-2 text-xs font-normal text-gray-600 whitespace-nowrap dark:text-gray-400 w-4">
    {% if splitTransaction is defined %}
        <svg class="w-4 h-4 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 3a3 3 0 0 0-1 5.83v6.34a3.001 3.001 0 1 0 2 0V15a2 2 0 0 1 2-2h1a5.002 5.002 0 0 0 4.927-4.146A3.001 3.001 0 0 0 16 3a3 3 0 0 0-1.105 5.79A3.001 3.001 0 0 1 12 11h-1c-.729 0-1.412.195-2 .535V8.83A3.001 3.001 0 0 0 8 3Z"/>
        </svg>
    {% endif%}
</td>
<td class="p-1 px-2 text-xs font-normal text-gray-600 whitespace-nowrap dark:text-gray-400">
    <a
        href="{{ path('app_transaction_update', {'id': transaction.id}) }}"
        class=""
        data-turbo-frame="mdl"
    >
        {{ transaction.valutaDate|date('d.m.Y') }}
    </a>
</td>
<td class="p-1 px-2 text-xs font-normal text-gray-600 whitespace-nowrap dark:text-gray-400">
    {% if splitTransaction is defined %}
        {% set popOverId = splitTransaction.id %}
    {% else %}
        {% set popOverId = transaction.id %}
    {% endif%}
    <span data-popover-target="popover-transaction-{{ popOverId }}">{{ transaction.name }}</span>

    <div
        data-popover id="popover-transaction-{{ popOverId }}"
        role="tooltip"
        class="absolute z-30 invisible inline-block text-xs text-gray-500 transition-opacity duration-300 bg-white border border-gray-200 rounded-lg shadow-sm opacity-0 w-80 dark:bg-gray-800 dark:border-gray-600 dark:text-gray-400"
    >
        <div class="px-3 py-2 text-wrap text-ellipsis overflow-hidden ...">
            <p>{{ transaction.descriptionRaw|replace({'/': ' ', '+' : ' '}) }}</p>
        </div>
        <div data-popper-arrow></div>
    </div>
</td>
<td
    class="text-xs font-normal text-gray-600 whitespace-nowrap dark:text-gray-400 cursor-pointer relative overflow-visible"
{#    data-action="click->transaction#showCategoryDropdown"#}
{#    data-transaction-id="{{ transaction.id }}"#}
{#    data-split-transaction-id="{% if splitTransaction is defined %}{{ splitTransaction.id }}{% else %}0{% endif %}"#}
{#    data-transaction-category-id="{% if splitTransaction is defined and splitTransaction.category %}{{ splitTransaction.category.id }}{% elseif transaction.category %}{{ transaction.category.id }}{% endif %}"#}
>
    <div
        class="relative w-full"
        data-controller="ta-dropdown"
        data-action="ta-dropdown:opening@window->ta-dropdown-manager#closeAll"
    >
        <button
{#            class="w-full flex justify-between items-center text-left bg-white border border-slate-200 hover:border-blue-400 text-slate-600 text-[11px] rounded px-2 py-1 transition-all"#}
            class="w-full flex justify-between items-center text-left text-slate-600 text-[11px] rounded px-2 py-1 transition-all"
            data-action="click->ta-dropdown#toggle"
        >
            <span id="label-1">Food</span>
            <svg class="w-3 h-3 ml-1 text-slate-400 hidden" data-ta-dropdown-target="arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>

        <div
            class="dropdown-content absolute left-0 mt-1 bg-white border border-slate-200 rounded-md shadow-xl overflow-hidden hidden"
            data-ta-dropdown-target="dropdown"
        >
            <div class="p-2 border-b border-slate-100 bg-slate-50">
                <input type="text" id="search-1" placeholder="Search..." data-ta-dropdown-target="search" onkeyup="handleKeyNavigation(event, 1)" class="w-full text-[11px] border border-slate-200 rounded px-2 py-1 focus:ring-1 focus:ring-blue-400 outline-none">
            </div>
            <div class="max-h-48 overflow-y-auto py-1" id="list-1">
                <div class="group-container">
                    <div class="px-3 py-1 text-[9px] font-bold text-slate-400 uppercase bg-slate-50/50">Personal</div>

                    <button onclick="selectCategory(1, 'Food')" class="cat-item w-full text-left px-3 py-1.5 text-[11px] text-slate-600 hover:bg-blue-50 hover:text-blue-700 transition-colors">
                        Food
                    </button>
                </div>
            </div>
        </div>
    </div>




