<td class="py-[8px] px-3 font-mono text-[12px] text-white/40 overflow-hidden text-ellipsis whitespace-nowrap">
    {{ transaction.valutaDate|date('d.m.') }}
</td>
<td class="py-[8px] px-3 text-white font-[450] text-ellipsis whitespace-nowrap">
    {% if splitTransaction is defined %}
        {% set popOverId = splitTransaction.id %}
    {% else %}
        {% set popOverId = transaction.id %}
    {% endif%}

    <div class="recv-wrap relative inline-block max-w-full">
        <span data-popover-target="popover-transaction-{{ popOverId }}" class="recv-name block overflow-hidden text-ellipsis whitespace-nowrap">{{ transaction.name }}</span>
        <div
            data-popover id="popover-transaction-{{ popOverId }}"
            role="tooltip"
            class="tooltip absolute z-50 invisible inline-block bg-card border border-white/[.15] rounded-lg px-3 py-2 text-[12px] text-white/70 shadow-[0_8px_28px_rgba(0,0,0,.45)]"
        >
            <div class="px-3 py-2 text-wrap text-ellipsis overflow-hidden ...">
                <p>{{ transaction.descriptionRaw|replace({'/': ' ', '+' : ' '}) }}</p>
            </div>
            <div data-popper-arrow></div>
        </div>
    </div>
</td>

<td class="py-[8px] px-3 overflow-hidden">
    {% if splitTransaction is defined %}
        {% set tr = splitTransaction %}
    {% elseif transaction.category %}
        {% set tr = transaction %}
    {% endif %}

    {% if tr is defined %}
    <span style="{{ cat_styles(tr.category.categoryGroup?.color) }}" class="px-2 py-0.5 rounded-full text-xs font-medium">
        {{ tr.category.categoryGroup
        ? tr.category.categoryGroup.name ~ ':' ~ tr.category.name
        : tr.category.name }}
    </span>
    {% endif %}

{#    <svg class="w-3 h-3 ml-1 text-slate-400 hidden" data-ta-dropdown-target="arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>#}
</td>

{% if transaction.isCredit %}
    {% set fontClass = 'text-green' %}
    {% set sign = '+' %}
{% else %}
    {% set fontClass = 'text-white/70' %}
    {% set sign = '-' %}
{% endif %}
<td class="py-[8px] px-3 text-right font-mono text-[13px] {{ fontClass}} overflow-hidden text-ellipsis whitespace-nowrap">
{% if splitTransaction is defined %}
{{ sign }}&nbsp;{{ splitTransaction.amountAsCurrency|format_currency('EUR', {}) }}</td>
{% else %}
{{ sign }}&nbsp;{{ transaction.amountAsCurrency|format_currency('EUR', {}) }}
{% endif %}
</td>


