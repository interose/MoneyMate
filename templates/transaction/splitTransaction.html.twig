{% extends 'base.html.twig' %}

{% block body %}
    <turbo-frame id="mdl">
        <!-- Header -->
        <div class="flex items-center justify-between px-[22px] py-5 border-b border-white/[.07]">
            <span class="text-[14.5px] font-semibold">Split transaction</span>
            <button
                data-action="mdl#close"
                class="flex items-center justify-center w-[26px] h-[26px] rounded-md bg-white/[.05] border border-white/[.07] hover:bg-white/10 transition-colors cursor-pointer border-0"
            >
                <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none"><path d="M2 2l8 8M10 2l-8 8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></path></svg>
            </button>
        </div>

        <!-- Original transaction summary -->
        <div class="px-[22px] pt-4 pb-4 border-b border-white/[.07]">
            <div class="flex items-center justify-between gap-4 bg-elevated rounded-lg px-4 py-3">
                <p class="text-[12.5px] text-white/50 leading-relaxed flex-1 line-clamp-2">
                    {{ transaction.descriptionRaw|replace({'/': ' ', '+' : ' '}) }}
                </p>
                <span
                    class="font-mono text-[14px] font-semibold text-white whitespace-nowrap flex-shrink-0 pl-4"
                    data-transaction-amount-target="differenceAmount"
                >
                    {{ transaction.getAmountDifferenceAsCurrency|format_currency('EUR', {}) }}
                </span>
            </div>
        </div>

        <twig:SplitTransactionForm :form="form" :transaction="transaction" />
    </turbo-frame>
{% endblock %}
