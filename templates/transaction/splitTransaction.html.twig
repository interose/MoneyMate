{% extends 'base.html.twig' %}

{% block body %}
    <turbo-frame id="mdl">
        {% if app.request.headers.get('turbo-frame') is not empty %}
            <twig:ModalHeader>Split transaction</twig:ModalHeader>
        {% endif %}

        <!-- Original transaction summary -->
        <div class="px-[22px] pt-4 pb-4 border-b border-white/[.07]">
            <div class="flex items-center justify-between gap-4 bg-elevated rounded-lg px-4 py-3">
                <p class="text-[12.5px] text-white/50 leading-relaxed flex-1 line-clamp-2">
                    {{ transaction.descriptionRaw|replace({'/': ' ', '+' : ' '}) }}
                </p>
                <span
                    class="font-mono text-[14px] font-semibold text-white whitespace-nowrap flex-shrink-0 pl-4"
                    data-transaction-amount-target="differenceAmount"
                >
                    {{ transaction.getAmountDifferenceAsCurrency|format_currency('EUR', {}) }}
                </span>
            </div>
        </div>

        <twig:SplitTransactionForm :form="form" :transaction="transaction" />
    </turbo-frame>
{% endblock %}
