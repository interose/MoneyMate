{% extends 'base.html.twig' %}

{% block body %}
    <twig:Header title=""></twig:Header>

    <div class="grid grid-cols-6 gap-4 px-4 pt-6 dark:bg-gray-900">
        <twig:Card title="Edit Online Credentials" grid="col-start-2 col-end-5">
            <turbo-frame id="mdl">
                {% if app.request.headers.get('turbo-frame') is not empty %}
                    <twig:ModalHeader>Edit Online Credentials</twig:ModalHeader>
                {% endif %}

                {{ form_start(form) }}

                <div class="grid grid-cols-2 gap-4">
                    <div>{{ form_row(form.username) }}</div>
                    <div>{{ form_row(form.password) }}</div>
                </div>

                <div class="flex justify-end">
                    <button class="text-white bg-green-700 hover:bg-green-800 focus:outline-none font-medium rounded-lg text-sm px-5 py-2 text-center mt-4 inline-flex items-center">
                        <i class="fa-solid fa-floppy-disk me-2.5"></i>Save
                    </button>
                </div>

                {{ form_end(form) }}
            </turbo-frame>
        </twig:Card>
    </div>
{% endblock %}
