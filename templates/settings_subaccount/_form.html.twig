{{ form_start(form) }}
    {{ form_row(form.iban) }}
    {{ form_row(form.accountNumber) }}

    <div class="mb-3 relative">
        {% do form.enabled.setRendered() %}
        <label class="inline-flex items-center cursor-pointer" for="{{ form.enabled.vars.id }}">
            <input id="{{ form.enabled.vars.id }}" type="checkbox" name="{{ form.enabled.vars.full_name }}" value="1" class="sr-only peer" {% if form.enabled.vars.data == "1" %}checked="checked"{% endif %}>
            <div class="relative w-11 h-6 bg-gray-200 rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-gray-600 peer-checked:bg-blue-600"></div>
            <span class="ms-3 text-sm font-medium text-gray-900 dark:text-gray-300">Enabled</span>
        </label>
    </div>

    {{ form_row(form.description) }}

    {% if app.request.headers.get('turbo-frame') is not empty and app.request.headers.get('turbo-frame') == 'form-drawer' %}
        <div class="bottom-0 left-0 flex justify-start w-full pb-4 space-x-4 md:px-4 md:absolute">
            <button class="text-white bg-green-700 hover:bg-green-800 focus:outline-none font-medium rounded-lg text-sm px-5 py-2 text-center mt-4 inline-flex items-center">
                <i class="fa-solid fa-floppy-disk me-2.5"></i>{{ button_label|default('Save') }}
            </button>
        </div>
    {% else %}
        <div class="flex justify-end">
            <button class="text-white bg-green-700 hover:bg-green-800 focus:outline-none font-medium rounded-lg text-sm px-5 py-2 text-center mt-4 inline-flex items-center">
                <i class="fa-solid fa-floppy-disk me-2.5"></i>{{ button_label|default('Save') }}
            </button>
        </div>
    {% endif %}
{{ form_end(form) }}
