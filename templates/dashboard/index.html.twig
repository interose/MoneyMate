{% extends 'base.html.twig' %}

{% block body %}
    <div class="flex flex-row bg-white border-b border-gray-200 dark:bg-gray-800 dark:border-gray-700">
        <div class="flex-1"></div>

        {% set mainAccountId = get_main_account_id() %}
        {% if mainAccountId != 0 %}
            <div class="p-2 flex items-center text-xs font-medium text-center text-gray-600">
                {{ get_current_balance(mainAccountId)|format_currency('EUR') }}
            </div>
            <div class="p-2 flex items-center text-xs font-medium text-center text-gray-600">
                <a href="{{ path('app_account_update_statements', {'id': mainAccountId}) }}" data-turbo-frame="mdl" class="p-1 px-2 me-1 text-xs font-medium text-center inline-flex items-center text-gray-600 rounded bg-gray-100 hover:bg-gray-200 border border-gray-300">
                    <svg class="size-4 text-gray-600 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m16 10 3-3m0 0-3-3m3 3H5v3m3 4-3 3m0 0 3 3m-3-3h14v-3"/>
                    </svg>
                    Update Transactions
                </a>
            </div>
        {% endif %}
    </div>
    <div class="grid grid-cols-1 gap-4 px-4 pt-4 dark:bg-gray-900">
        <twig:Card title="Turnover" grid="">
            <div class="grid grid-cols-1 gap-4 px-4 pt-4 dark:bg-gray-900 h-96">
                <div
                        data-controller="dashboard-chart"
                        data-dashboard-chart-target="chart"
                        data-dashboard-chart-turnover-data-value='{{ turnoverChartData|raw }}'
                >
                </div>
            </div>
        </twig:Card>
    </div>
{% endblock %}
