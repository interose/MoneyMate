{% extends 'base.html.twig' %}

{% block body %}
    <twig:Header title="Application Settings">
    </twig:Header>

    <div class="grid grid-cols-8 gap-4 px-4 pt-6 dark:bg-gray-900">
        <twig:Card grid="col-span-8 xl:col-start-2 xl:col-end-8">
            {{ form_start(form) }}
            <div class="mb-8 pb-8 border-b">
                <h3 class="mb-4 font-medium leading-tight">Generic Application Settings</h3>
                {{ form_row(form.mainAccount) }}
            </div>

            <div class="mb-8">
                <h3 class="mb-4 font-medium leading-tight">Account "Boersenverlag"</h3>
                <p class="text-xs text-gray-500 dark:text-gray-400 inline-flex items-center mb-4">
                    <svg class="size-4 me-1.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                        <path fill-rule="evenodd" d="M2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10S2 17.523 2 12Zm9.008-3.018a1.502 1.502 0 0 1 2.522 1.159v.024a1.44 1.44 0 0 1-1.493 1.418 1 1 0 0 0-1.037.999V14a1 1 0 1 0 2 0v-.539a3.44 3.44 0 0 0 2.529-3.256 3.502 3.502 0 0 0-7-.255 1 1 0 0 0 2 .076c.014-.398.187-.774.48-1.044Zm.982 7.026a1 1 0 1 0 0 2H12a1 1 0 1 0 0-2h-.01Z" clip-rule="evenodd"></path>
                    </svg>
                    Currently, only the import of the Champions list is supported. To use this service, a valid account with <a class="underline underline-offset-4" href="https://www.boersenverlag.de/" target="_blank">"Börsenverlag"</a> is required.
                </p>
                <div class="grid grid-cols-3 gap-4">
                    <div class="flex items-center">
                        {% do form.boerseAccountEnabled.setRendered() %}
                        <label class="inline-flex items-center cursor-pointer mb-3" for="{{ form.boerseAccountEnabled.vars.id }}">
                            <input id="{{ form.boerseAccountEnabled.vars.id }}" type="checkbox" name="{{ form.boerseAccountEnabled.vars.full_name }}" value="1" class="sr-only peer" {% if form.boerseAccountEnabled.vars.data == "1" %}checked="checked"{% endif %}>
                            <div class="relative w-11 h-6 bg-gray-200 rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-gray-600 peer-checked:bg-blue-600"></div>
                            <span class="ms-3 text-sm font-medium text-gray-900 dark:text-gray-300">Enabled</span>
                        </label>
                    </div>
                    <div>{{ form_row(form.boersePublisherUser) }}</div>
                    <div>{{ form_row(form.boersePublisherPw) }}</div>
                </div>

                <div>
                    {{ form_row(form.boerseDividendUrl) }}
                </div>
            </div>

            <div class="flex justify-between">
                <a
                    class="text-gray-900 bg-gray-100 hover:bg-gray-200 focus:outline-none font-medium rounded-lg text-sm px-5 py-2 text-center mt-4 inline-flex items-center"
                    href="{{ path('app_settings_global_index') }}"
                >
                    back
                </a>
                <button class="text-white bg-green-700 hover:bg-green-800 focus:outline-none font-medium rounded-lg text-sm px-5 py-2 text-center mt-4 inline-flex items-center">
                    <i class="fa-solid fa-floppy-disk me-2.5"></i>Save
                </button>
            </div>

            {{ form_end(form) }}
        </twig:Card>
    </div>
{% endblock %}
