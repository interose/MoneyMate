{% extends 'base.html.twig' %}

{% block pageheader %}
    <div class="flex items-center justify-between px-8 pt-7 pb-5 shrink-0" style="border-bottom:1px solid var(--border)">
        <div>
            <div class="text-[20px] font-semibold tracking-tight">Settings</div>
            <div class="text-[12px] mt-0.5 text-muted">Manage accounts, links, and third-party providers</div>
        </div>
    </div>
{% endblock %}

{% block body %}
    <!-- Horizontal tab bar -->
    <div class="flex items-end gap-1 px-8 shrink-0" style="border-bottom:1px solid var(--border)">
        <a href="{{ path('app_settings_index') }}" class="tab-btn active">App-Settings</a>
        <a href="{{ path('app_settings_accounts_index') }}" class="tab-btn">Accounts</a>
    </div>

    <div id="view-appsettings" class="flex-1 overflow-y-auto px-8 py-7">
        <div class="flex items-center justify-between mb-5">
            <div>
                <div class="font-semibold text-[15px]">App Settings</div>
                <div class="text-[12px] text-muted mt-0.5">Default accounts and third-party integrations used across the app</div>
            </div>
            <a href="{{ path('app_settings_edit') }}" class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-lg bg-accent text-white text-[13px] font-medium cursor-pointer border-none transition-all hover:-translate-y-px hover:bg-[#7aa0f7] hover:shadow-[0_4px_14px_rgba(91,138,245,.3)]">
                ✎ Edit
            </a>
        </div>

        <div class="max-w-2xl flex flex-col gap-6">

            <!-- ── Section: Account links ── -->
            <div class="rounded-xl overflow-hidden" style="border:1px solid var(--border)">

                <!-- Section header -->
                <div class="flex items-center gap-3 px-5 py-4" style="background:var(--surface);border-bottom:1px solid var(--border)">
                    <div class="w-8 h-8 rounded-lg flex items-center justify-center text-base shrink-0" style="background:rgba(91,138,245,.12);color:#5b8af5">⇄</div>
                    <div>
                        <div class="font-semibold text-[13px]">Account Links</div>
                        <div class="text-[11px] text-muted">Choose which account is used for which role</div>
                    </div>
                </div>

                <!-- Main account -->
                <div class="setting-row flex items-center justify-between px-5 py-4 cursor-default" style="border-bottom:1px solid var(--border)">
                    <div class="flex items-center gap-3">
                        <div class="w-7 h-7 rounded-md flex items-center justify-center text-[13px] shrink-0" style="background:rgba(62,207,142,.12);color:#3ecf8e">★</div>
                        <div>
                            <div class="text-[13px] font-medium">Main Account</div>
                            <div class="text-[11px] text-muted mt-0.5">Primary account for expense analysis and the dashboard</div>
                        </div>
                    </div>
                    <div class="text-right">
                        {% if settings.mainAccount %}
                            <div class="text-[13px] font-medium" id="display-main-account">{{ settings.mainAccount.account.name }}</div>
                            <div class="text-[11px] text-muted font-mono" id="display-main-blz">{{ settings.mainAccount.iban }}</div>
                        {% else %}
                            <div class="text-[13px] font-medium text-muted" id="display-main-account">Not configured</div>
                            <a href="{{ path('app_settings_edit') }}" class="text-[11px] text-accent">Set up →</a>
                        {% endif %}
                    </div>
                </div>

                <!-- Stock account -->
                <div class="setting-row flex items-center justify-between px-5 py-4 cursor-default">
                    <div class="flex items-center gap-3">
                        <div class="w-7 h-7 rounded-md flex items-center justify-center text-[13px] shrink-0" style="background:rgba(181,124,245,.12);color:#b57cf5">◈</div>
                        <div>
                            <div class="text-[13px] font-medium">Securities Account</div>
                            <div class="text-[11px] text-muted mt-0.5">Account for securities trading and dividends</div>
                        </div>
                    </div>
                    <div class="text-right">
                        {% if settings.stockAccount %}
                            <div class="text-[13px] font-medium" id="display-stock-account">{{ settings.stockAccount.account.name }}</div>
                            <div class="text-[11px] text-muted font-mono" id="display-stock-blz">{{ settings.stockAccount.iban }}</div>
                        {% else %}
                            <div class="text-[13px] font-medium text-muted" id="display-stock-account">Not configured</div>
                            <a href="{{ path('app_settings_edit') }}" class="text-[11px] text-accent">Set up →</a>
                        {% endif %}
                    </div>
                </div>

            </div>

            <!-- ── Section: Stock Publisher ── -->
            <div class="rounded-xl overflow-hidden" style="border:1px solid var(--border)">

                <div class="flex items-center gap-3 px-5 py-4" style="background:var(--surface);border-bottom:1px solid var(--border)">
                    <div class="w-8 h-8 rounded-lg flex items-center justify-center text-base shrink-0" style="background:rgba(245,166,35,.12);color:#f5a623">📈</div>
                    <div>
                        <div class="font-semibold text-[13px]">Stock Publisher · Stock Champions</div>
                        <div class="text-[11px] text-muted">Credentials for the automatic import of Stock Champions data</div>
                    </div>
                </div>

                <!-- Username -->
                <div class="setting-row flex items-center justify-between px-5 py-4 cursor-default" style="border-bottom:1px solid var(--border)">
                    <div class="flex items-center gap-3">
                        <span class="text-muted text-[13px]">👤</span>
                        <div>
                            <div class="text-[13px] font-medium">Username</div>
                            <div class="text-[11px] text-muted mt-0.5">Login name for boersenverlag.de</div>
                        </div>
                    </div>
                    <span class="text-[13px] font-mono text-muted" id="display-bv-user">m.weber@example.de</span>
                </div>

                <!-- Password -->
                <div class="setting-row flex items-center justify-between px-5 py-4 cursor-default">
                    <div class="flex items-center gap-3">
                        <span class="text-muted text-[13px]">🔑</span>
                        <div>
                            <div class="text-[13px] font-medium">Password</div>
                            <div class="flex items-center gap-1.5 text-[11px] text-muted mt-0.5">
                                <span class="text-accent text-[10px]">🔒</span> Stored encrypted
                            </div>
                        </div>
                    </div>
                    <span class="text-[13px] font-mono text-muted tracking-widest">••••••••</span>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
