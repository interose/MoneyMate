{% extends 'base.html.twig' %}

{% block pageheader %}
    <div class="flex items-center justify-between px-8 pt-7 pb-5 shrink-0" style="border-bottom:1px solid var(--border)">
        <div>
            <div class="text-[20px] font-semibold tracking-tight">Settings</div>
            <div class="text-[12px] mt-0.5 text-muted">Konten, Verknüpfungen und Drittanbieter konfigurieren</div>
        </div>
    </div>
{% endblock %}

{% block body %}
    <!-- Horizontal tab bar -->
    <div class="flex items-end gap-1 px-8 shrink-0" style="border-bottom:1px solid var(--border)">
        <a href="{{ path('app_settings_index') }}" class="tab-btn active">App-Settings</a>
        <a href="{{ path('app_settings_accounts_index') }}" class="tab-btn">Accounts</a>
    </div>

    <div id="view-appsettings" class="flex-1 overflow-y-auto px-8 py-7">
        <div class="flex items-center justify-between mb-5">
            <div>
                <div class="font-semibold text-[15px]">App Settings</div>
                <div class="text-[12px] text-muted mt-0.5">TODO: Subheadline</div>
            </div>
        </div>

        <div class="max-w-2xl flex flex-col gap-6">

            <!-- ── Section: Account links ── -->
            <div class="rounded-xl overflow-hidden" style="border:1px solid var(--border)">

                <!-- Section header -->
                <div class="flex items-center gap-3 px-5 py-4" style="background:var(--surface);border-bottom:1px solid var(--border)">
                    <div class="w-8 h-8 rounded-lg flex items-center justify-center text-base shrink-0" style="background:rgba(91,138,245,.12);color:#5b8af5">⇄</div>
                    <div>
                        <div class="font-semibold text-[13px]">Kontoverknüpfungen</div>
                        <div class="text-[11px] text-muted">Legen Sie fest, welches Konto welche Rolle übernimmt</div>
                    </div>
                </div>

                <!-- Main account -->
                <div class="setting-row flex items-center justify-between px-5 py-4 cursor-default" style="border-bottom:1px solid var(--border)">
                    <div class="flex items-center gap-3">
                        <div class="w-7 h-7 rounded-md flex items-center justify-center text-[13px] shrink-0" style="background:rgba(62,207,142,.12);color:#3ecf8e">★</div>
                        <div>
                            <div class="text-[13px] font-medium">Hauptkonto</div>
                            <div class="text-[11px] text-muted mt-0.5">Primäres Konto für Ausgabenauswertungen und Dashboard</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="text-right">
                            <div class="text-[13px] font-medium" id="display-main-account">Deutsche Bank</div>
                            <div class="text-[11px] text-muted font-mono" id="display-main-blz">DE89 7005 0000 1234 5678 90</div>
                        </div>
                        <button class="setting-edit-btn w-7 h-7 rounded-lg flex items-center justify-center text-[12px] cursor-pointer transition-all text-muted hover:text-accent hover:border-accent hover:bg-[rgba(91,138,245,.12)]" style="border:1px solid var(--border);background:transparent" onclick="openSettingModal('main-account')" title="Bearbeiten">✎</button>
                    </div>
                </div>

                <!-- Stock account -->
                <div class="setting-row flex items-center justify-between px-5 py-4 cursor-default">
                    <div class="flex items-center gap-3">
                        <div class="w-7 h-7 rounded-md flex items-center justify-center text-[13px] shrink-0" style="background:rgba(181,124,245,.12);color:#b57cf5">◈</div>
                        <div>
                            <div class="text-[13px] font-medium">Depotkonto</div>
                            <div class="text-[11px] text-muted mt-0.5">Konto für Wertpapiergeschäfte und Dividenden</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="text-right">
                            <div class="text-[13px] font-medium" id="display-stock-account">Comdirect</div>
                            <div class="text-[11px] text-muted font-mono" id="display-stock-blz">DE75 2004 1133 0123 4567 00</div>
                        </div>
                        <button class="setting-edit-btn w-7 h-7 rounded-lg flex items-center justify-center text-[12px] cursor-pointer transition-all text-muted hover:text-accent hover:border-accent hover:bg-[rgba(91,138,245,.12)]" style="border:1px solid var(--border);background:transparent" onclick="openSettingModal('stock-account')" title="Bearbeiten">✎</button>
                    </div>
                </div>

            </div>

            <!-- ── Section: Börsenverlag ── -->
            <div class="rounded-xl overflow-hidden" style="border:1px solid var(--border)">

                <div class="flex items-center gap-3 px-5 py-4" style="background:var(--surface);border-bottom:1px solid var(--border)">
                    <div class="w-8 h-8 rounded-lg flex items-center justify-center text-base shrink-0" style="background:rgba(245,166,35,.12);color:#f5a623">📈</div>
                    <div>
                        <div class="font-semibold text-[13px]">Börsenverlag · Stock Champions</div>
                        <div class="text-[11px] text-muted">Zugangsdaten für den automatischen Import der Stock-Champions-Daten</div>
                    </div>
                </div>

                <!-- Username -->
                <div class="setting-row flex items-center justify-between px-5 py-4 cursor-default" style="border-bottom:1px solid var(--border)">
                    <div class="flex items-center gap-3">
                        <span class="text-muted text-[13px]">👤</span>
                        <div>
                            <div class="text-[13px] font-medium">Benutzername</div>
                            <div class="text-[11px] text-muted mt-0.5">Login-Name für boersenverlag.de</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="text-[13px] font-mono text-muted" id="display-bv-user">m.weber@example.de</span>
                        <button class="setting-edit-btn w-7 h-7 rounded-lg flex items-center justify-center text-[12px] cursor-pointer transition-all text-muted hover:text-accent hover:border-accent hover:bg-[rgba(91,138,245,.12)]" style="border:1px solid var(--border);background:transparent" onclick="openSettingModal('bv-credentials')" title="Bearbeiten">✎</button>
                    </div>
                </div>

                <!-- Password -->
                <div class="setting-row flex items-center justify-between px-5 py-4 cursor-default">
                    <div class="flex items-center gap-3">
                        <span class="text-muted text-[13px]">🔑</span>
                        <div>
                            <div class="text-[13px] font-medium">Passwort</div>
                            <div class="flex items-center gap-1.5 text-[11px] text-muted mt-0.5">
                                <span class="text-accent text-[10px]">🔒</span> Verschlüsselt gespeichert
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="text-[13px] font-mono text-muted tracking-widest">••••••••</span>
                        <button class="setting-edit-btn w-7 h-7 rounded-lg flex items-center justify-center text-[12px] cursor-pointer transition-all text-muted hover:text-accent hover:border-accent hover:bg-[rgba(91,138,245,.12)]" style="border:1px solid var(--border);background:transparent" onclick="openSettingModal('bv-credentials')" title="Bearbeiten">✎</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
