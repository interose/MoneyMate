{% extends 'base.html.twig' %}

{% block body %}

<div
    data-controller="category-manager"
    class="flex flex-col flex-1 overflow-hidden"
>
    <!-- Topbar -->
    <header class="flex items-center h-14 px-6 gap-4 border-b border-white/[.07] flex-shrink-0">
        <span class="text-[15px] font-semibold tracking-tight">Categories</span>
        <div class="ml-auto flex items-center gap-2">
            <a
                href="{{ path('app_settings_categorygroup_new') }}"
                class="grad inline-flex items-center gap-[6px] px-[14px] py-[7px] rounded-lg text-[13px] font-medium text-white shadow-[0_3px_12px_rgba(67,72,224,.3)] hover:opacity-90 transition-opacity cursor-pointer border-0"
                data-turbo-frame="mdl"
                data-modal-width="400px"
            >
                <svg class="w-[14px] h-[14px]" viewBox="0 0 14 14" fill="none"><path d="M7 2v10M2 7h10" stroke="white" stroke-width="1.5" stroke-linecap="round"/></svg>
                Add Category Group
            </a>
        </div>
    </header>

    <!-- Two-panel layout -->
    <div class="flex flex-1 overflow-hidden">

        <!-- ── LEFT PANEL: Groups list ───────────────────────────── -->
        <div class="flex flex-col w-[280px] flex-shrink-0 border-r border-white/[.07] overflow-hidden">

            <!-- Panel header -->
            <div class="flex items-center justify-between px-4 py-3 border-b border-white/[.07]">
                <span class="text-[11px] font-semibold tracking-[.07em] uppercase text-white/40">Category groups</span>
                <span data-category-manager-target="groupCount" class="font-mono text-[11px] text-white/25">{{ groups|length }}</span>
            </div>

            <!-- Groups scrollable list -->
            <div class="scroll-area flex-1 overflow-y-auto py-2 px-2">
                <div class="scroll-area flex-1 overflow-y-auto py-2 px-2">
                    {% for group in groups %}
                        <a
                            href="{{ path('app_settings_categories_by_group', {'id': group.id}) }}"
                            id="group-list-item-{{ group.id }}"
                            data-category-manager-target="groupLink"
                            data-action="click->category-manager#toggle"
                            data-turbo-frame="category-panel"
                            class="group-item flex items-center gap-3 px-3 py-[9px] rounded-lg border border-transparent cursor-pointer hover:bg-white/[.04] transition-colors"
                        >
                            <div class="w-3 h-3 rounded-full flex-shrink-0" style="background:{{ group.color }};box-shadow:0 0 0 2px {{ group.color }}33"></div>
                            <span class="group-name flex-1 text-[13px] text-white/70 truncate">{{ group.name }}</span>
                            <span class="font-mono text-[11px] text-white/25 flex-shrink-0">{{ group.categories|length }}</span>
                        </a>
                    {% endfor %}

                    <div class="group-item flex items-center gap-3 px-3 py-[9px] rounded-lg border border-transparent cursor-pointer hover:bg-white/[.04] transition-colors">
                        <div class="w-3 h-3 rounded-full flex-shrink-0" style="background:rgba(100,116,139,.5);border:1.5px solid rgba(100,116,139,.4)"></div>
                        <span class="group-name flex-1 text-[13px] text-white/50 truncate">Ungrouped</span>
                        <span class="font-mono text-[11px] text-white/25">{{ countUngrouped }}</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ── RIGHT PANEL: Group detail + categories ────────────── -->
        <div class="flex flex-col flex-1 overflow-hidden">
            <turbo-frame
                id="category-panel"
                class="flex flex-col flex-1 overflow-hidden"
            >
                <!-- Empty state -->
                <div class="flex flex-col items-center justify-center flex-1 gap-3">
                    <div class="w-12 h-12 rounded-xl bg-white/[.04] flex items-center justify-center">
                        <svg class="w-6 h-6 text-white/20" viewBox="0 0 16 16" fill="none"><rect x="2" y="3" width="12" height="10" rx="1.5" stroke="currentColor" stroke-width="1.3"/><path d="M5 7h6M5 10h3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
                    </div>
                    <p class="text-[13px] text-white/25">Select group</p>
                </div>
            </turbo-frame>
        </div>
    </div>
</div>

{% endblock %}
