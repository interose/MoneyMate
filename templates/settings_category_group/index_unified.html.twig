{% extends 'base.html.twig' %}

{% block main_css_class %}p-8{% endblock %}

{% block body %}
    <header class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-black text-slate-800 dark:text-white tracking-tight">Category Groups</h1>
            <p class="text-slate-500 font-medium">Organize your categories into high-level financial buckets.</p>
        </div>
    </header>

    <div class="flex gap-8">

        <div class="w-1/3 space-y-4">
            <h2 class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-4 px-2">Category Groups</h2>

            {% for group in groups %}
                <a href="{{ path('app_settings_categories_by_group', {'id': group.id}) }}" data-turbo-frame="category-panel" class="block p-4 bg-white/50 dark:bg-slate-900/50 rounded-2xl border border-slate-200 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700 transition-all group">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-4">
                            <div class="w-3 h-10 rounded-full opacity-50" {% if group.color is not empty %}style="background-color: {{ group.color }}"{% endif %}></div>
                            <div>
                                <p class="font-bold text-slate-500 dark:text-slate-400">{{ group.name }}</p>
                                <p class="text-xs text-slate-400">{{ group.categories|length }} Categories</p>
                            </div>
                        </div>
                    </div>
                </a>
            {% endfor %}
        </div>

        <div class="flex-1 bg-white dark:bg-slate-900 rounded-[2.5rem] border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden min-h-[600px]">
            <turbo-frame id="category-panel" class="aria-busy:opacity-50 aria-busy:blur-sm transition-all">
            </turbo-frame>
        </div>
    </div>
{% endblock %}
