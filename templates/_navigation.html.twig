{% macro linkCssClass(route, prefix) %}
    {% if route starts with prefix %}
        class="flex items-center p-2 text-sm text-gray-900 transition duration-75 rounded-lg pl-10 group hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-700 bg-gray-100 dark:bg-gray-700"
    {% else %}
        class="flex items-center p-2 text-sm text-gray-900 transition duration-75 rounded-lg pl-10 group hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-700"
    {% endif %}
{% endmacro %}

<aside id="sidebar" class="fixed top-0 left-0 z-20 flex flex-col flex-shrink-0 hidden w-52 h-full font-normal duration-75 lg:flex transition-width" aria-label="Sidebar">
    <div class="relative flex flex-col flex-1 min-h-0 pt-2 bg-white border-r border-gray-200 dark:bg-gray-800 dark:border-gray-700">
        <div class="flex flex-col flex-1 pt-2 pb-4 overflow-y-auto">
            <div class="flex-1 px-3 space-y-1 bg-white divide-y divide-gray-200 dark:bg-gray-800 dark:divide-gray-700">
                <ul class="pb-2 space-y-1">
                    <li>
                        <a href="{{ path('app_dashboard')}}" class="flex items-center p-2 text-sm text-gray-900 rounded-lg hover:bg-gray-100 group dark:text-gray-200 dark:hover:bg-gray-700 {% if app.request.get('_route') == 'app_dashboard' %}bg-gray-100 dark:bg-gray-700{% endif %}">
                            <i class="fa-solid fa-house text-gray-500 transition duration-75 group-hover:text-gray-900 dark:text-gray-400 dark:group-hover:text-white"></i>
                            <span class="ml-2">Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('app_transaction_index')}}" class="flex items-center p-2 text-sm text-gray-900 rounded-lg hover:bg-gray-100 group dark:text-gray-200 dark:hover:bg-gray-700 {% if app.request.get('_route') == 'app_transaction_index' %}bg-gray-100 dark:bg-gray-700{% endif %}">
                            <i class="fa-solid fa-table-cells-large text-gray-500 transition duration-75 group-hover:text-gray-900 dark:text-gray-400 dark:group-hover:text-white"></i>
                            <span class="ml-2">Monthly</span>
                        </a>
                    </li>
                    {% if stock_enabled() %}
                        <li>
                            <a href="{{ path('app_stock_index')}}" class="flex items-center p-2 text-sm text-gray-900 rounded-lg hover:bg-gray-100 group dark:text-gray-200 dark:hover:bg-gray-700 {% if app.request.get('_route') == 'app_stock_index' %}bg-gray-100 dark:bg-gray-700{% endif %}">
                                <i class="fa-solid fa-arrow-trend-up text-gray-500 transition duration-75 group-hover:text-gray-900 dark:text-gray-400 dark:group-hover:text-white"></i>
                                <span class="ml-2">Stock Champions</span>
                            </a>
                        </li>
                    {% endif %}
                    <li>
                        <button type="button" class="flex items-center w-full p-2 text-sm text-gray-900 transition duration-75 rounded-lg group hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-700" aria-controls="dropdown-settings" data-collapse-toggle="dropdown-settings">
                            <i class="fa-solid fa-gears text-gray-500 transition duration-75 group-hover:text-gray-900 dark:text-gray-400 dark:group-hover:text-white"></i>
                            <span class="flex-1 ml-2 text-left whitespace-nowrap">Settings</span>
                            <i class="fa-solid fa-angle-down"></i>
                        </button>
                        <ul
                            id="dropdown-settings"
                            {% if app.request.get('_route') starts with 'app_settings_'  %}
                                class="py-2 space-y-0"
                            {% else %}
                                class="hidden py-2 space-y-0"
                            {% endif %}
                        >
                            <li>
                                <a
                                    href="{{ path('app_settings_categorygroup_index') }}"
                                    {{ _self.linkCssClass(app.request.get('_route'), 'app_settings_categorygroup_') }}
                                >
                                    Category Groups</a>
                            </li>
                            <li>
                                <a
                                    href="{{ path('app_settings_category_index') }}"
                                    {{ _self.linkCssClass(app.request.get('_route'), 'app_settings_category_') }}
                                >
                                    Categories
                                </a>
                            </li>
                            <li>
                                <a
                                    href="{{ path('app_settings_rule_index') }}"
                                    {{ _self.linkCssClass(app.request.get('_route'), 'app_settings_rule_') }}
                                >
                                    Rules
                                </a>
                            </li>
                            <li>
                                <a
                                    href="{{ path('app_settings_account_index') }}"
                                    {{ _self.linkCssClass(app.request.get('_route'), 'app_settings_account_') }}
                                >
                                    Accounts
                                </a>
                            </li>
                            <li>
                                <a
                                    href="{{ path('app_settings_global_index') }}"
                                    {{ _self.linkCssClass(app.request.get('_route'), 'app_settings_global_') }}
                                >
                                    App Settings
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</aside>
