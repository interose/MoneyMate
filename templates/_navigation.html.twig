{% macro linkCssClass(route, prefix) %}
    {% if route starts with prefix %}
        class="flex items-center p-2 text-sm transition duration-75 rounded-lg pl-10 group opacity-70"
    {% else %}
        class="flex items-center p-2 text-sm transition duration-75 rounded-lg pl-10 group opacity-70 hover:bg-slate-800 hover:opacity-100"
    {% endif %}
{% endmacro %}

<aside id="sidebar" class="fixed top-0 left-0 z-20 flex flex-col flex-shrink-0 hidden w-64 h-full font-normal duration-75 lg:flex transition-width bg-[#0f172a] text-white" aria-label="Sidebar">

    <div class="flex items-center gap-3 mb-10">
        <div class="bg-indigo-600 p-2 rounded-xl shadow-lg shadow-indigo-600/30">
            <i class="fa-solid fa-vault text-xl"></i>
        </div>
        <span class="text-xl font-extrabold tracking-tight">VaultFlow</span>
    </div>

    <div class="p-6 text-sm">
        <nav class="space-y-1">
            <a href="{{ path('app_dashboard')}}" class="flex items-center gap-3 p-2 rounded-xl transition-all {% if app.request.get('_route') == 'app_dashboard' %}bg-indigo-600 font-semibold shadow-lg shadow-indigo-600/20{% else %}hover:bg-slate-800 opacity-70 hover:opacity-100{% endif %}">
                <i class="fa-solid fa-house w-5"></i> Dashboard
            </a>
            <a href="{{ path('app_transaction_index')}}" class="flex items-center gap-3 p-2 rounded-xl transition-all {% if app.request.get('_route') == 'app_transaction_index' %}bg-indigo-600 font-semibold shadow-lg shadow-indigo-600/20{% else %}hover:bg-slate-800 opacity-70 hover:opacity-100{% endif %}">
                <i class="fa-solid fa-calendar-days w-5"></i> Monthly
            </a>
            {% if stock_enabled() %}
                <a href="{{ path('app_stock_index')}}" class="flex items-center gap-3 p-2 rounded-xl transition-all {% if app.request.get('_route') == 'app_stock_index' %}bg-indigo-600 font-semibold shadow-lg shadow-indigo-600/20{% else %}hover:bg-slate-800 opacity-70 hover:opacity-100{% endif %}">
                    <i class="fa-solid fa-arrow-trend-up w-5"></i> Stock Champions
                </a>
            {% endif %}

            <div class="pt-8 pb-2 space-y-1">
                <p class="text-[10px] font-bold text-slate-500 uppercase tracking-[0.2em] px-3 mb-4">Settings</p>
                <a href="{{ path('app_settings_categorygroup_index_unified') }}" class="flex items-center gap-3 p-2 rounded-xl transition-all {% if app.request.get('_route') == 'app_settings_categorygroup_index_unified' %}bg-indigo-600 font-semibold shadow-lg shadow-indigo-600/20{% else %}hover:bg-slate-800 opacity-60 hover:opacity-100{% endif %}">
                    <i class="fa-solid fa-layer-group w-5"></i> Categories
                </a>
                <a href="{{ path('app_settings_rule_index') }}" class="flex items-center gap-3 p-2 rounded-xl transition-all {% if app.request.get('_route') == 'app_settings_rule_index' %}bg-indigo-600 font-semibold shadow-lg shadow-indigo-600/20{% else %}hover:bg-slate-800 opacity-60 hover:opacity-100{% endif %}">
                    <i class="fa-solid fa-wand-magic-sparkles w-5"></i> Rules
                </a>
                <a href="{{ path('app_settings_account_index') }}" class="flex items-center gap-3 p-2 rounded-xl transition-all {% if app.request.get('_route') == 'app_settings_account_index' %}bg-indigo-600 font-semibold shadow-lg shadow-indigo-600/20{% else %}hover:bg-slate-800 opacity-60 hover:opacity-100{% endif %}">
                    <i class="fa-solid fa-building-columns w-5"></i> Accounts
                </a>
                <a href="{{ path('app_settings_global_index') }}" class="flex items-center gap-3 p-2 rounded-xl transition-all {% if app.request.get('_route') == 'app_settings_global_index' %}bg-indigo-600 font-semibold shadow-lg shadow-indigo-600/20{% else %}hover:bg-slate-800 opacity-60 hover:opacity-100{% endif %}">
                    <i class="fa-solid fa-sliders w-5"></i> App Settings
                </a>
            </div>
        </nav>
    </div>

</aside>




