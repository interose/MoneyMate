{% macro linkCssClass(route, prefix) %}
    {% if route starts with prefix %}
        class="nav-item nav-active relative flex items-center gap-[9px] px-[10px] py-2 rounded-lg cursor-pointer text-white text-[13px] font-medium bg-accent/[.14]"
    {% else %}
        class="nav-item relative flex items-center gap-[9px] px-[10px] py-2 rounded-lg cursor-pointer text-white/70 text-[13px] hover:bg-white/5 hover:text-white transition-colors"
    {% endif %}
{% endmacro %}

<nav class="flex flex-col w-[220px] h-screen flex-shrink-0 bg-elevated border-r border-white/[.07]">
    <!-- Logo -->
    <div class="flex items-center gap-[10px] px-4 py-[18px]">
        <img src="{{ asset('images/logo_neu.png') }}"/>
    </div>

    <!-- Nav sections -->
    <div class="flex flex-col px-[10px] pt-3 pb-1 gap-[2px]">
        <p class="text-[9.5px] font-semibold tracking-[.08em] uppercase text-white/40 px-2 mb-1">Overview</p>

        <a href="{{ path('app_dashboard')}}" {{ _self.linkCssClass(app.request.get('_route'), 'app_dashboard') }}>
            <svg class="w-4 h-4 opacity-65 flex-shrink-0" viewBox="0 0 16 16" fill="none"><rect x="1.5" y="1.5" width="5.5" height="5.5" rx="1.2" stroke="currentColor" stroke-width="1.3"/><rect x="9" y="1.5" width="5.5" height="5.5" rx="1.2" stroke="currentColor" stroke-width="1.3"/><rect x="1.5" y="9" width="5.5" height="5.5" rx="1.2" stroke="currentColor" stroke-width="1.3"/><rect x="9" y="9" width="5.5" height="5.5" rx="1.2" stroke="currentColor" stroke-width="1.3"/></svg>
            Dashboard
        </a>

        <a href="{{ path('app_transaction_index')}}" {{ _self.linkCssClass(app.request.get('_route'), 'app_transaction_index') }}>
            <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 16 16" fill="none"><path d="M2 5h12M2 8h12M2 11h7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
            Transactions
{#            <span class="ml-auto text-[10px] font-mono bg-pink/20 text-pink px-[5px] py-px rounded-full">52</span>#}
        </a>

        {% if stock_enabled() %}
            <a href="{{ path('app_stock_index')}}" {{ _self.linkCssClass(app.request.get('_route'), 'app_stock_index') }}>
                <svg class="w-4 h-4 opacity-65 flex-shrink-0" viewBox="0 0 16 16" fill="none"><path d="M2 13l3-4 2.5 2L10 7l2 2.5L14 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/><path d="M13 4h-3M13 4v3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
                Stock Champions
            </a>
        {% endif %}
    </div>

    <div class="flex flex-col px-[10px] pt-3 pb-1 gap-[2px]">
        <p class="text-[9.5px] font-semibold tracking-[.08em] uppercase text-white/40 px-2 mb-1">Administration</p>
        <a href="{{ path('app_settings_categorygroup_index_unified') }}" {{ _self.linkCssClass(app.request.get('_route'), 'app_settings_categorygroup_index_unified') }}>
            <svg class="w-4 h-4 opacity-65 flex-shrink-0" viewBox="0 0 16 16" fill="none"><rect x="2" y="3" width="12" height="10" rx="1.5" stroke="currentColor" stroke-width="1.3"/><path d="M5 7h6M5 10h3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
            Categories
        </a>
        <a href="{{ path('app_settings_rule_index') }}" {{ _self.linkCssClass(app.request.get('_route'), 'app_settings_rule_index') }}>
            <svg class="w-4 h-4 opacity-65 flex-shrink-0" viewBox="0 0 16 16" fill="none"><path d="M2 4h12M2 8h8M2 12h5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><circle cx="12.5" cy="11.5" r="2.5" stroke="currentColor" stroke-width="1.3"/><path d="M12.5 10.5v1l.7.7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
            Rules
        </a>
        <a href="{{ path('app_settings_account_index') }}" {{ _self.linkCssClass(app.request.get('_route'), 'app_settings_account_index') }}>
            <svg class="w-4 h-4 opacity-65 flex-shrink-0" viewBox="0 0 16 16" fill="none"><rect x="1.5" y="4" width="13" height="9" rx="1.5" stroke="currentColor" stroke-width="1.3"/><path d="M1.5 7h13" stroke="currentColor" stroke-width="1.3"/><circle cx="4.5" cy="10.5" r="1" fill="currentColor"/><circle cx="7.5" cy="10.5" r="1" fill="currentColor"/></svg>
            Accounts
        </a>
        <a href="{{ path('app_settings_global_index') }}" {{ _self.linkCssClass(app.request.get('_route'), 'app_settings_global_index') }}>
            <svg class="w-4 h-4 opacity-65 flex-shrink-0" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="2" stroke="currentColor" stroke-width="1.3"/><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.22 3.22l1.41 1.41M11.37 11.37l1.41 1.41M3.22 12.78l1.41-1.41M11.37 4.63l1.41-1.41" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
            Settings
        </a>
    </div>
</nav>
