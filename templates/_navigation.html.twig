{% macro linkCssClass(route, prefix) %}
    {% if route starts with prefix %}nav-active{% else %}nav-idle{% endif %}
{% endmacro %}

<nav class="w-[220px] min-h-screen flex flex-col pb-6 shrink-0 border-r transition-colors duration-300"
     style="background:var(--surface);border-color:var(--border)">

    <!-- Logo -->
    <div class="flex items-center gap-[10px] px-4 py-[18px]">
        <img src="{{ asset('images/logo_neu.png') }}"/>
    </div>

    <span class="px-5 pt-4 pb-1.5 font-mono text-[10px] tracking-[1.2px] text-muted uppercase">Overview</span>
    <a href="{{ path('app_dashboard')}}" class="{{ _self.linkCssClass(app.request.get('_route'), 'app_dashboard') }} flex items-center gap-2.5 px-5 py-2.5 text-[13px] cursor-pointer border-l-2 transition-all">
        <svg class="w-4 h-4 opacity-65 flex-shrink-0" viewBox="0 0 16 16" fill="none"><rect x="1.5" y="1.5" width="5.5" height="5.5" rx="1.2" stroke="currentColor" stroke-width="1.3"/><rect x="9" y="1.5" width="5.5" height="5.5" rx="1.2" stroke="currentColor" stroke-width="1.3"/><rect x="1.5" y="9" width="5.5" height="5.5" rx="1.2" stroke="currentColor" stroke-width="1.3"/><rect x="9" y="9" width="5.5" height="5.5" rx="1.2" stroke="currentColor" stroke-width="1.3"/></svg>
        Dashboard
    </a>
    <a href="{{ path('app_transaction_index')}}" class="{{ _self.linkCssClass(app.request.get('_route'), 'app_transaction_index') }} flex items-center gap-2.5 px-5 py-2.5 text-[13px] cursor-pointer border-l-2 transition-all">
        <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 16 16" fill="none"><path d="M2 5h12M2 8h12M2 11h7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
        Transactions
    </a>

    <a href="{{ path('app_stock_index')}}" class="{{ _self.linkCssClass(app.request.get('_route'), 'app_stock_index') }} flex items-center gap-2.5 px-5 py-2.5 text-[13px] cursor-pointer border-l-2 transition-all">
        <svg class="w-4 h-4 opacity-65 flex-shrink-0" viewBox="0 0 16 16" fill="none"><path d="M2 13l3-4 2.5 2L10 7l2 2.5L14 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/><path d="M13 4h-3M13 4v3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
        Stock Champions
    </a>

    <span class="px-5 pt-4 pb-1.5 font-mono text-[10px] tracking-[1.2px] text-muted uppercase">Administration</span>
    <a href="{{ path('app_settings_categorygroup_index') }}" class="{{ _self.linkCssClass(app.request.get('_route'), 'app_settings_categorygroup_index') }} flex items-center gap-2.5 px-5 py-2.5 text-[13px] cursor-pointer border-l-2 transition-all">
        <svg class="w-4 h-4 opacity-65 flex-shrink-0" viewBox="0 0 16 16" fill="none"><rect x="2" y="3" width="12" height="10" rx="1.5" stroke="currentColor" stroke-width="1.3"/><path d="M5 7h6M5 10h3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
        Categories
    </a>
    <a href="{{ path('app_settings_rule_index') }}" class="{{ _self.linkCssClass(app.request.get('_route'), 'app_settings_rule_index') }} flex items-center gap-2.5 px-5 py-2.5 text-[13px] cursor-pointer border-l-2 transition-all">
        <svg class="w-4 h-4 opacity-65 flex-shrink-0" viewBox="0 0 16 16" fill="none"><path d="M2 4h12M2 8h8M2 12h5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><circle cx="12.5" cy="11.5" r="2.5" stroke="currentColor" stroke-width="1.3"/><path d="M12.5 10.5v1l.7.7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
        Rules
    </a>
    <a href="{{ path('app_settings_global_index') }}" class="{{ _self.linkCssClass(app.request.get('_route'), 'app_settings_global_index') }} flex items-center gap-2.5 px-5 py-2.5 text-[13px] cursor-pointer border-l-2 transition-all">
        <svg class="w-4 h-4 opacity-65 flex-shrink-0" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="2" stroke="currentColor" stroke-width="1.3"/><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.22 3.22l1.41 1.41M11.37 11.37l1.41 1.41M3.22 12.78l1.41-1.41M11.37 4.63l1.41-1.41" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
        Settings
    </a>

    <div class="flex-1"></div>
    <div data-controller="theme-switch" style="border-top:1px solid var(--border)">
        <div data-theme-switch-target="switchButton" data-action="click->theme-switch#toggle" class="flex items-center gap-3 px-5 py-3 cursor-pointer text-[12px] text-muted">
            <div class="toggle-pill" data-theme-switch-target="pill"></div>
            <span data-theme-switch-target="label">Light mode</span>
        </div>
    </div>
</nav>
